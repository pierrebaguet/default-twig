{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Search results for'|trans }} {{ term }}{% endblock %}
{% block body_testid %}search-results{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Search'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% macro row(key, row) %}
    {% if key == 'products' %}
        <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-break">
                <a class="text-decoration-none" href="{{ path('admin.products.update', { product_id: row.id }) }}">{{ row.label }}</a>
                {% if row.combination_ref %}<span class="d-block text-muted small" data-testid="search-product-combination">{{ 'Combination %ref%'|trans({ '%ref%': row.combination_ref }) }}</span>{% endif %}
            </span>
            <span class="text-muted small text-nowrap">{{ row.ref }}</span>
        </li>
    {% elseif key == 'combinations' %}
        <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-break">
                <a class="text-decoration-none" href="{{ path('admin.products.update', { product_id: row.product_id, current_tab: 'pse' }) }}">{{ row.label }}</a>
                {% if row.attributes %}<span class="d-block text-muted small">{{ row.attributes }}</span>{% endif %}
            </span>
            <span class="text-muted small text-end">{{ row.ref }}{% if row.ean_code %}<span class="d-block">{{ row.ean_code }}</span>{% endif %}</span>
        </li>
    {% elseif key == 'categories' %}
        <li class="list-group-item"><a class="text-decoration-none" href="{{ path('admin.categories.update', { category_id: row.id }) }}">{{ row.label }}</a></li>
    {% elseif key == 'folders' %}
        <li class="list-group-item"><a class="text-decoration-none" href="{{ path('admin.folders.update', { folder_id: row.id }) }}">{{ row.label }}</a></li>
    {% elseif key == 'contents' %}
        <li class="list-group-item"><a class="text-decoration-none" href="{{ path('admin.content.update', { content_id: row.id }) }}">{{ row.label }}</a></li>
    {% elseif key == 'brands' %}
        <li class="list-group-item"><a class="text-decoration-none" href="{{ path('admin.brand.update', { brand_id: row.id }) }}">{{ row.label }}</a></li>
    {% elseif key == 'customers' %}
        <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-break"><a class="text-decoration-none" href="{{ path('admin.customer.update.view', { customer_id: row.id }) }}">{{ row.label }}</a>{% if row.ref %} <span class="text-muted small">({{ row.ref }})</span>{% endif %}</span>
            {% if row.email %}<span class="text-muted small text-break">{{ row.email }}</span>{% endif %}
        </li>
    {% elseif key == 'orders' %}
        <li class="list-group-item d-flex justify-content-between gap-3">
            <a class="text-decoration-none" href="{{ path('admin.order.update.view', { order_id: row.id }) }}">{{ row.ref }}</a>
            {% if row.invoice_ref %}<span class="text-muted small">{{ row.invoice_ref }}</span>{% endif %}
        </li>
    {% elseif key == 'coupons' %}
        <li class="list-group-item d-flex justify-content-between gap-3">
            <a class="text-decoration-none text-break" href="{{ path('admin.coupon.update', { couponId: row.id }) }}">{{ row.label }}</a>
            {% if row.code and row.code != row.label %}<span class="text-muted small text-nowrap">{{ row.code }}</span>{% endif %}
        </li>
    {% elseif key == 'sales' %}
        <li class="list-group-item"><a class="text-decoration-none" href="{{ path('admin.sale.update', { sale_id: row.id }) }}">{{ row.label }}</a></li>
    {% elseif key == 'administrators' %}
        <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-break"><a class="text-decoration-none" href="{{ path('admin.configuration.administrators.view', { edit: row.id }) }}">{{ row.label|trim ?: row.login }}</a> <span class="text-muted small">({{ row.login }})</span></span>
            {% if row.email %}<span class="text-muted small text-break">{{ row.email }}</span>{% endif %}
        </li>
    {% elseif key == 'modules' %}
        <li class="list-group-item d-flex justify-content-between gap-3">
            <a class="text-decoration-none text-break" href="{{ path('admin.module.update', { module_id: row.id }) }}">{{ row.label }}</a>
            <span class="text-muted small text-nowrap">{{ row.code }}</span>
        </li>
    {% endif %}
{% endmacro %}

{% block content %}
    {{ safe_hook('search.top', { location: 'search_top' }) }}

    {% set titles = {
        products: 'Products', combinations: 'Combinations', categories: 'Categories', folders: 'Folders',
        contents: 'Contents', brands: 'Brands', customers: 'Customers', orders: 'Orders',
        coupons: 'Coupons', sales: 'Sales', administrators: 'Administrators', modules: 'Modules',
    } %}
    {% set empty_messages = {
        products: 'No product match.', combinations: 'No combination match.', categories: 'No category match.',
        folders: 'No folder match.', contents: 'No content match.', brands: 'No brand match.',
        customers: 'No customer match.', orders: 'No order match.', coupons: 'No coupon match.',
        sales: 'No sale match.', administrators: 'No administrator match.', modules: 'No module match.',
    } %}

    <div class="container-fluid" data-testid="search-page">
        <h1 class="h3 mb-3">{{ 'Search results'|trans }} <small class="text-muted">"{{ term }}"</small></h1>

        {% if rate_limited|default(false) %}
            <div class="alert alert-warning" role="alert" data-testid="search-rate-limited">{{ 'Too many searches in a row. Please try again in a minute.'|trans }}</div>
        {% elseif term is empty %}
            <p class="text-muted">{{ 'Type a search term in the top bar.'|trans }}</p>
        {% elseif too_short %}
            <div class="alert alert-info" data-testid="search-too-short">{{ 'Please enter at least %count% characters to search.'|trans({ '%count%': min_length }) }}</div>
        {% else %}
            {% if only %}
                <p class="mb-3"><a href="{{ path('admin.search', { search_term: term }) }}" data-testid="search-back-to-all">&lsaquo; {{ 'Back to all the results'|trans }}</a></p>
            {% endif %}

            {% set found = groups|filter(result => result.total > 0) %}
            {% if found is empty %}
                <p class="text-muted" data-testid="search-no-result">{{ 'No result matches this term.'|trans }}</p>
            {% endif %}

            <div class="row g-4">
                {% for key, result in found %}
                    <div class="{{ only ? 'col-12' : 'col-md-6' }}">
                        <div class="card" data-testid="search-group-{{ key }}">
                            <div class="card-header d-flex align-items-center gap-2">
                                <span>{{ titles[key]|trans }}</span>
                                <span class="badge bg-secondary" data-testid="search-group-{{ key }}-total">
                                    {%- if result.isTruncated and not only -%}
                                        {{ '%shown% of %total%'|trans({ '%shown%': result.rows|length, '%total%': result.total }) }}
                                    {%- else -%}
                                        {{ result.total }}
                                    {%- endif -%}
                                </span>
                            </div>
                            <ul class="list-group list-group-flush">
                                {% for row in result.rows %}
                                    {{ _self.row(key, row) }}
                                {% else %}
                                    {# Only past the last page of a group shown on its own. #}
                                    <li class="list-group-item text-muted small">{{ empty_messages[key]|trans }}</li>
                                {% endfor %}
                                {% if result.isTruncated and not only %}
                                    <li class="list-group-item small">
                                        {% if filtered_lists[key] is defined %}
                                            <a href="{{ path(filtered_lists[key], { q: term }) }}" data-testid="search-group-{{ key }}-list">{{ 'Open the list filtered on this term'|trans }}</a>
                                        {% else %}
                                            <a href="{{ path('admin.search', { search_term: term, group: key }) }}" data-testid="search-group-{{ key }}-all">{{ 'See the %count% results'|trans({ '%count%': result.total }) }}</a>
                                        {% endif %}
                                    </li>
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% if only %}
                {{ component('BoPagination', {
                    route: 'admin.search',
                    currentPage: page,
                    lastPage: pages,
                    routeParams: { search_term: term, group: only },
                    ariaLabel: 'Search results pagination',
                    testid: 'search-pagination',
                }) }}
            {% endif %}
        {% endif %}
    </div>

    {{ safe_hook('search.bottom', { location: 'search_bottom' }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('search.js', { location: 'search-js' }) }}
{% endblock %}
