{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit content'|trans }} - {{ content.title }}{% endblock %}
{% block body_testid %}folder-content-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.folders.default') }}">{{ 'Folders'|trans }}</a></li>
            {% for crumb in breadcrumb_path|default([]) %}
                <li class="breadcrumb-item"><a href="{{ path('admin.folders.default', { folder_id: crumb.id }) }}">{{ crumb.title }}</a></li>
            {% endfor %}
            <li class="breadcrumb-item active" aria-current="page">{{ content.title }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('content-edit.top', { content_id: content.id }) }}

    {% set extra_tabs = hook_block('content.tab', { content: content.id, id: content.id }) %}

    <div class="container-fluid" data-testid="content-edit-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Content'|trans }} <small class="text-muted">#{{ content.id }}</small></h1>
            <div class="d-flex flex-wrap gap-2">
                {% include '@BackOfficeDefaultTwig/fragments/publication-preview.html.twig' with {
                    type: 'content',
                    preview_link: preview_link|default(null),
                    preview_url: preview_url|default(null),
                    title: 'Preview content page'|trans,
                } only %}
                <a href="{{ path('admin.folders.default', { folder_id: content.defaultFolderId|default(0) }) }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back'|trans }}
                </a>
            </div>
        </div>

        <div class="bo-tab-bar">
            <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('general') == 'general' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" data-testid="content-tab-general">
                    {{ 'General'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('') == 'images' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-images" type="button" data-testid="content-tab-images">
                    {{ 'Images'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('') == 'documents' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button" data-testid="content-tab-documents">
                    {{ 'Documents'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('') == 'seo' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-seo" type="button" data-testid="content-tab-seo">
                    {{ 'SEO'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('') == 'associations' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-associations" type="button" data-testid="content-tab-associations">
                    {{ 'Associations'|trans }}
                </button>
            </li>
            {% for block in extra_tabs %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#{{ block.id }}"
                            {% if block.href is defined and block.href %}data-href="{{ block.href }}"{% endif %}
                            type="button" data-testid="content-tab-{{ block.id }}">{{ block.title }}</button>
                </li>
            {% endfor %}
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('') == 'modules' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-modules" type="button" data-testid="content-tab-modules">
                    {{ 'Modules'|trans }}
                </button>
            </li>
        </ul>
            <div class="bo-tab-bar__aside">
                {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
            </div>
        </div>

        <div class="tab-content">
            <div class="tab-pane fade {% if current_tab|default('general') == 'general' %}show active{% endif %}" id="tab-general" role="tabpanel">
                <div class="card">
                    <div class="card-body">
                        {% form_theme form with bo_form_themes only %}
                        {{ form_start(form, { action: path('admin.content.save'), method: 'post', attr: { 'data-testid': 'content-edit-form' } }) }}
                            <input type="hidden" name="content_id" value="{{ content.id }}">

                            <div class="row g-3">
                                <div class="col-md-8">
                                    <div class="mb-3">
                                        {{ form_label(form.title) }}
                                        {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
                                        {{ form_errors(form.title) }}
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(form.chapo) }}
                                        {{ form_widget(form.chapo, { attr: { class: 'form-control', rows: 3 } }) }}
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(form.description) }}
                                        {{ form_widget(form.description, { attr: { class: 'form-control', rows: 8 } }) }}
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(form.postscriptum) }}
                                        {{ form_widget(form.postscriptum, { attr: { class: 'form-control', rows: 3 } }) }}
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    {{ safe_hook('content.modification.form-right.top', { content_id: content.id }) }}
                                    {% if publication|default(null) %}
                                        {% include '@BackOfficeDefaultTwig/fragments/publication-panel.html.twig' with { publication: publication } only %}
                                    {% else %}
                                        <div class="form-check mb-3">
                                            {{ form_widget(form.visible, { attr: { class: 'form-check-input' } }) }}
                                            {{ form_label(form.visible, null, { label_attr: { class: 'form-check-label' } }) }}
                                        </div>
                                    {% endif %}
                                    <div class="mb-3">
                                        <label class="form-label" for="content_default_folder">{{ 'Default folder'|trans }}</label>
                                        <select name="thelia_content_modification[default_folder]" id="content_default_folder" class="form-select" data-testid="content-default-folder">
                                            {% for folder in folders %}
                                                <option value="{{ folder.id }}" {% if folder.id == content.defaultFolderId %}selected{% endif %}>{{ folder.title }}</option>
                                            {% endfor %}
                                        </select>
                                        {% do form.default_folder.setRendered %}
                                    </div>
                                    {{ safe_hook('content.modification.form-right.bottom', { content_id: content.id }) }}
                                    {% set edit_toolbar = {
                                        closeUrl: path('admin.folders.default', { folder_id: content.defaultFolderId|default(0) }),
                                        closeFirst: false,
                                        closeIcon: 'bi-x-lg',
                                        saveIcon: 'bi-check-lg',
                                        saveCloseIcon: 'bi-x-lg',
                                        saveVariant: 'success',
                                        saveCloseVariant: 'info',
                                        iconAfterLabel: true,
                                        align: 'start'
                                    } %}
                                    {% set edit_dates = 'Content created on %date_create. Last modification on %date_change'|trans({
                                        '%date_create': content.createdAt ? content.createdAt|format_datetime('medium', 'short') : '-',
                                        '%date_change': content.updatedAt ? content.updatedAt|format_datetime('medium', 'short') : '-',
                                    }) %}
                                    {{ component('BoSaveModeToolbar', edit_toolbar|merge({ wrapperClass: 'mb-2', testid: 'content-edit-top' })) }}
                                    <p class="small text-muted mb-3" data-testid="content-edit-dates-top">{{ edit_dates }}</p>
                                </div>
                            </div>
                            {{ form_widget(form.id) }}
                            {{ form_widget(form.locale) }}
                            {{ safe_hook('content.update-form', { content: content.id }) }}
                            {{ component('BoSaveModeToolbar', edit_toolbar|merge({ testid: 'content-edit' })) }}
                            <p class="small text-muted mt-3 mb-0" data-testid="content-edit-dates">{{ edit_dates }}</p>
                        {{ form_widget(form._token) }}
                        {# module fields added through the legacy form bridge are rendered by the module hooks, not auto-dumped #}
                        {{ form_end(form, {render_rest: false}) }}
                        {% if publication|default(null) %}
                            {% include '@BackOfficeDefaultTwig/fragments/publication-form.html.twig' with { publication: publication } only %}
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="tab-pane fade {% if current_tab|default('') == 'images' %}show active{% endif %}" id="tab-images" role="tabpanel">
                {# The media forms need the right to update: without it, the sheet is shown without them. #}
                {% if is_granted('UPDATE', 'admin.content') %}
                    {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\File\\FileController::imageForm', { parentType: 'content', parentId: content.id })) }}
                {% endif %}
            </div>

            <div class="tab-pane fade {% if current_tab|default('') == 'documents' %}show active{% endif %}" id="tab-documents" role="tabpanel">
                {% if is_granted('UPDATE', 'admin.content') %}
                    {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\File\\FileController::documentForm', { parentType: 'content', parentId: content.id })) }}
                {% endif %}
            </div>

            <div class="tab-pane fade {% if current_tab|default('') == 'seo' %}show active{% endif %}" id="tab-seo" role="tabpanel">
                {{ safe_hook('tab-seo.top', { id: content.id, type: 'content' }) }}
                <div class="card">
                    <div class="card-body">
                        {% form_theme seo_form with bo_form_themes only %}
                        {{ form_start(seo_form, { action: path('admin.content.seo.save'), method: 'post', attr: { 'data-testid': 'content-seo-form' } }) }}
                            <div class="mb-3">
                                {{ form_label(seo_form.url) }}
                                {{ form_widget(seo_form.url, { attr: { class: 'form-control' } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(seo_form.meta_title) }}
                                {{ form_widget(seo_form.meta_title, { attr: { class: 'form-control' } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(seo_form.meta_description) }}
                                {{ form_widget(seo_form.meta_description, { attr: { class: 'form-control', rows: 3 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(seo_form.meta_keywords) }}
                                {{ form_widget(seo_form.meta_keywords, { attr: { class: 'form-control', rows: 2 } }) }}
                            </div>
                            {{ form_widget(seo_form.id) }}
                            {{ form_widget(seo_form.locale) }}
                            <button type="submit" class="btn btn-primary" data-testid="content-seo-submit">
                                <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                            </button>
                        {{ form_widget(seo_form._token) }}
                        {# module fields added through the legacy form bridge are rendered by the module hooks, not auto-dumped #}
                        {{ form_end(seo_form, {render_rest: false}) }}
                    </div>
                </div>
                {{ hook_cards(['content.seo.update-form', 'tab-seo.update-form', 'tab-seo.bottom'], { content_id: content.id, id: content.id, type: 'content' }) }}
            </div>

            <div class="tab-pane fade {% if current_tab|default('') == 'associations' %}show active{% endif %}" id="tab-associations" role="tabpanel">
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5">{{ 'Folders this content also belongs to'|trans }}</h2>
                        <form action="{{ path('admin.content.additional-folder.add') }}" method="post" class="mb-3" data-testid="content-additional-folder-form">
                            <input type="hidden" name="content_id" value="{{ content.id }}">
                            <div class="input-group">
                                <select name="additional_folder_id" class="form-select" data-testid="content-additional-folder-select">
                                    {% for folder in available_additional_folders %}
                                        <option value="{{ folder.id }}">{{ folder.title }}</option>
                                    {% else %}
                                        <option value="" disabled>{{ 'All folders already linked'|trans }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit" class="btn btn-primary" data-testid="content-additional-folder-add" {% if available_additional_folders is empty %}disabled{% endif %}>
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add to folder'|trans }}
                                </button>
                            </div>
                        </form>
                        {% set rows = [] %}
                        {% for folder in additional_folders %}
                            {% set rows = rows|merge([{
                                'id': folder.id,
                                'title_html': folder.title ~ (folder.is_default ? ' <span class="badge bg-secondary ms-2">' ~ 'Default folder'|trans ~ '</span>' : ''),
                                '_actions': folder.is_default ? [] : [ row_action('delete', 'Delete'|trans, folder.delete_url, dataAttributes: { 'bo-post': '' }) ],
                            }]) %}
                        {% endfor %}
                        {{ component('BoDataTable', {
                            id: 'content-additional-folders-table',
                            columns: [
                                column_html('title_html', 'Folder'|trans),
                                column_actions(),
                            ],
                            rows: rows,
                            emptyMessage: 'No additional folder linked.'|trans,
                        }) }}
                    </div>
                </div>
            </div>

            {% for block in extra_tabs %}
                <div class="tab-pane fade" id="{{ block.id }}" role="tabpanel">
                    {% if block.href is defined and block.href %}
                        <div class="text-center"><span class="loading">{{ 'Please wait, loading'|trans }}</span></div>
                    {% else %}
                        {{ block.content|raw }}
                    {% endif %}
                </div>
            {% endfor %}

            <div class="tab-pane fade {% if current_tab|default('') == 'modules' %}show active{% endif %}" id="tab-modules" role="tabpanel">
                {{ hook_cards('content.tab-content', { content: content.id, content_id: content.id, location: 'content-edit', view: 'content' }) }}
            </div>
        </div>
    </div>

    {{ safe_hook('content-edit.bottom', { content_id: content.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('content.edit-js', { content_id: content.id, location: 'content-edit-js' }) }}
    {{ safe_hook('wysiwyg.js', { location: 'content-edit-js' }) }}
{% endblock %}
