{# Back-office top bar - mirrors the Smarty admin-layout.tpl navbar-top:
   brand, search, locale switcher, admin profile shortcut, view-site, logout.
   Hook names match the legacy template so third-party modules keep working. #}

{# Back-office top bar - mirrors the Smarty admin-layout.tpl navbar-top:
   brand logo, search, locale switcher, admin profile, view site, logout.
   Hooks (main.before-topbar / main.topbar-top / main.after-topbar) keep
   their legacy names so third-party modules keep working. #}

{% set current_lang = bo_current_language() %}

{{ safe_hook('main.before-topbar', { location: 'before_topbar' }) }}

{# `navbar-expand` (no breakpoint) keeps the bar horizontal at every width: there
   is no `.navbar-collapse` here, so a breakpoint-scoped expand class would only
   stack the items into a column below that breakpoint. The sidebar toggler is
   re-shown with `d-inline-flex`, which out-weighs the `display: none` that
   `.navbar-expand` puts on `.navbar-toggler`. #}
<nav class="bo-top-nav navbar navbar-expand bg-body border-bottom shadow-sm" data-testid="bo-top-nav">
    <div class="container-fluid flex-nowrap">
        <button class="navbar-toggler border-0 d-inline-flex d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#bo-side-nav-offcanvas" aria-controls="bo-side-nav-offcanvas" aria-label="{{ 'Toggle navigation'|trans }}">
            <i class="bi bi-list fs-3" aria-hidden="true"></i>
        </button>

        {% if is_granted('VIEW', 'admin.search') %}
            {# "/" moves the focus to the field from any screen, unless the administrator is already typing somewhere. #}
            <form class="d-none d-md-flex flex-grow-1 mx-3" role="search" action="{{ path('admin.search') }}" method="get" data-testid="bo-search-form" data-controller="bo-search-shortcut">
                <div class="input-group">
                    <span class="input-group-text bg-body-secondary border-end-0"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input type="search" id="search_term" name="search_term" value="{{ app.request.query.get('search_term', '') }}" class="form-control border-start-0 border-end-0" placeholder="{{ 'Search...'|trans }}" aria-keyshortcuts="/" aria-describedby="search_term_shortcut" data-bo-search-shortcut-target="field">
                    <span class="input-group-text bg-body border-start-0" id="search_term_shortcut" title="{{ 'Press / to search from any screen'|trans }}">
                        <kbd class="bg-body-secondary text-body-secondary border small" aria-hidden="true">/</kbd>
                        <span class="visually-hidden">{{ 'Press / to search from any screen'|trans }}</span>
                    </span>
                </div>
            </form>
        {% endif %}

        <ul class="navbar-nav flex-row ms-auto align-items-center">
            {% if is_granted('VIEW', 'admin.search') %}
                {# Below md the search field is hidden, so the search page keeps its own entry point. #}
                <li class="nav-item d-md-none">
                    <a class="nav-link" href="{{ path('admin.search') }}" title="{{ 'Search'|trans }}" data-testid="bo-top-nav-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <span class="visually-hidden">{{ 'Search'|trans }}</span>
                    </a>
                </li>
            {% endif %}

            {{ safe_hook('main.topbar-top') }}

            {# The running Thelia version, readable from every back-office page.
               Hidden below md, where the bar has no room left for it. #}
            <li class="nav-item d-none d-md-flex align-items-center">
                <span class="bo-top-nav__version" title="{{ 'Version'|trans }}" data-testid="bo-thelia-version">v{{ thelia_version }}</span>
            </li>

            <li class="nav-item dropdown" data-testid="bo-top-nav-langs">
                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{ 'Interface language'|trans }}">
                    <img src="{{ asset('backoffice/img/svgFlags/' ~ current_lang.code ~ '.svg') }}" alt="{{ current_lang.title }}" class="bo-top-nav__flag" width="22" height="14">
                    <span class="d-none d-lg-inline ms-1">{{ current_lang.title }}</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    {% for lang in bo_languages() %}
                        <li>
                            <a class="dropdown-item d-flex align-items-center{{ lang.id == current_lang.id ? ' active' : '' }}" href="{{ app.request.pathInfo }}?{{ app.request.query.all|merge({lang: lang.code})|url_encode }}">
                                <img src="{{ asset('backoffice/img/svgFlags/' ~ lang.code ~ '.svg') }}" alt="" class="bo-top-nav__flag me-2" width="22" height="14">
                                {{ lang.title }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/" title="{{ 'View site'|trans }}" target="_blank" rel="noopener" data-testid="bo-top-nav-view-site">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                    <span class="visually-hidden">{{ 'View site'|trans }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('admin.account.two-factor.view') }}" title="{{ 'Account security'|trans }}" data-testid="bo-top-nav-account-security">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    <span class="visually-hidden">{{ 'Account security'|trans }}</span>
                </a>
            </li>
            {% if not sale_unit_restricted() %}
            <li class="nav-item">
                <a class="nav-link" href="{{ path('admin.configuration.administrators.view-profile') }}" title="{{ 'Edit profile'|trans }}" data-testid="bo-top-nav-profile">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                    <span class="ms-1 d-none d-lg-inline">{{ bo_current_admin().firstname|default('Admin') }}</span>
                </a>
            </li>
            {% endif %}
            <li class="nav-item">
                <a class="nav-link text-danger" href="/admin/logout" title="{{ 'Logout'|trans }}" data-testid="bo-top-nav-logout">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    <span class="visually-hidden">{{ 'Logout'|trans }}</span>
                </a>
            </li>
        </ul>
    </div>
</nav>

{{ safe_hook('main.after-topbar', { location: 'after_topbar' }) }}
