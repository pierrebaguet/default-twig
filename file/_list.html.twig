{% set id_placeholder = kind == 'image' ? { parentType: parent_type, imageId: 0 } : { parentType: parent_type, documentId: 0 } %}
<div class="bo-file-list" data-controller="bo-file-list"
     data-bo-file-list-toggle-url-template-value="{{ path(urls.toggle, id_placeholder) }}"
     data-bo-file-list-delete-url-template-value="{{ path(urls.delete, id_placeholder) }}"
     data-bo-file-list-position-url-value="{{ path(urls.position, { parentType: parent_type, parentId: parent_id }) }}"
     data-bo-file-list-token-value="{{ assignToken() }}"
     data-bo-file-list-sortable-value="{{ kind == 'image' ? 'true' : 'false' }}">
    {% if items|length == 0 %}
        <div class="alert alert-info" data-testid="bo-file-list-empty">
            {% if kind == 'image' %}
                {{ 'No images yet. Upload some with the form above.'|trans }}
            {% else %}
                {{ 'No documents yet. Upload some with the form above.'|trans }}
            {% endif %}
        </div>
    {% else %}
        <ul class="list-unstyled row g-3" data-bo-file-list-target="grid" data-testid="bo-file-list-grid">
            {% for item in items|sort((a, b) => a.position <=> b.position) %}
                <li class="col-12 col-md-6 col-xl-4" data-bo-file-list-target="item" data-file-id="{{ item.id }}">
                    <div class="card h-100">
                        {% if kind == 'image' %}
                            {# The link is named on its own: the thumbnail alt is empty for a
                               decorative image, and empty for one not described yet. #}
                            <a href="{{ path(urls.update, { parentType: parent_type, imageId: item.id }) }}"
                               class="d-flex align-items-center justify-content-center bg-light p-2" style="height: 140px;"
                               aria-label="{{ 'Edit image %id'|trans({ '%id': item.id }) }}" data-testid="bo-file-thumb">
                                <img src="{{ item.url }}" alt="{{ item.resolved_alt|default('') }}" class="img-fluid" style="max-height: 100%;">
                            </a>
                        {% else %}
                            <a href="{{ path(urls.update, { parentType: parent_type, documentId: item.id }) }}"
                               class="d-flex flex-column align-items-center justify-content-center bg-light p-2 text-center" style="height: 140px;" data-testid="bo-file-thumb">
                                <i class="bi bi-file-earmark fs-1" aria-hidden="true"></i>
                                <div class="small text-truncate px-2 w-100">{{ item.file }}</div>
                            </a>
                        {% endif %}
                        <div class="card-body p-2 d-flex flex-column">
                            {% if can_update %}
                                <form method="post" action="{{ path(urls.update_title, kind == 'image' ? { parentType: parent_type, imageId: item.id } : { parentType: parent_type, documentId: item.id }) }}"
                                      class="mb-2" data-testid="bo-file-title-form-{{ item.id }}">
                                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                                    <input type="hidden" name="success_url" value="">
                                    <div class="input-group input-group-sm{% if kind == 'image' %} mb-2{% endif %}">
                                        <input type="text" name="title" value="{{ item.title }}" class="form-control" placeholder="{{ 'Title'|trans }}"
                                               aria-label="{{ 'Title'|trans }}" data-testid="bo-file-title-input-{{ item.id }}">
                                        {% if kind != 'image' %}
                                            <button type="submit" name="save_mode" value="stay" class="btn btn-outline-primary" title="{{ 'Save'|trans }}">
                                                <i class="bi bi-check2" aria-hidden="true"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                    {% if kind == 'image' %}
                                        <div class="input-group input-group-sm mb-1">
                                            <input type="text" name="alt" value="{{ item.alt|default('') }}" class="form-control"
                                                   placeholder="{{ 'Alternative text'|trans }}" aria-label="{{ 'Alternative text'|trans }}" maxlength="255"
                                                   data-alt-field data-action="input->bo-file-list#refreshAltWarning"
                                                   aria-describedby="decorative-hint-{{ parent_type }}-{{ item.id }}"
                                                   data-testid="bo-file-alt-input-{{ item.id }}"
                                                   {% if item.decorative|default(false) %}readonly{% endif %}>
                                            <button type="submit" name="save_mode" value="stay" class="btn btn-outline-primary" title="{{ 'Save'|trans }}"
                                                    data-testid="bo-file-inline-save-{{ item.id }}">
                                                <i class="bi bi-check2" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                        <div class="form-check form-check-inline small">
                                            {# The grid always states the flag, checked or not; a caller that sends
                                               nothing leaves it alone, which is what an old title-only link does. #}
                                            <input type="hidden" name="decorative" value="0">
                                            <input class="form-check-input" type="checkbox" name="decorative" value="1"
                                                   id="decorative-{{ parent_type }}-{{ item.id }}"
                                                   data-action="bo-file-list#toggleDecorative"
                                                   data-testid="bo-file-decorative-{{ item.id }}"
                                                   {% if item.decorative|default(false) %}checked{% endif %}>
                                            <label class="form-check-label" for="decorative-{{ parent_type }}-{{ item.id }}">{{ 'Decorative image'|trans }}</label>
                                        </div>
                                        {# Read-only rather than disabled: the field stays on the keyboard path,
                                           and says why it cannot be typed in. #}
                                        <div class="small text-muted{% if not item.decorative|default(false) %} d-none{% endif %}"
                                             id="decorative-hint-{{ parent_type }}-{{ item.id }}"
                                             data-decorative-hint data-testid="bo-file-decorative-hint-{{ item.id }}">
                                            {{ 'Silenced for a decorative image'|trans }}
                                        </div>
                                        <div class="small text-warning-emphasis{% if item.decorative|default(false) or item.alt|default('') is not empty %} d-none{% endif %}"
                                             data-alt-warning data-testid="bo-file-alt-warning-{{ item.id }}">
                                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> {{ 'No alternative text'|trans }}
                                        </div>
                                    {% endif %}
                                </form>
                            {% else %}
                                <div class="small fw-semibold text-truncate mb-2">{{ item.title }}</div>
                            {% endif %}
                            <div class="d-flex gap-2 justify-content-between align-items-center small text-muted mt-auto">
                                <span data-position-label="">#{{ item.position }}</span>
                                <div class="btn-group btn-group-sm">
                                    {% if can_update %}
                                        <button type="button" class="btn btn-outline-secondary" data-action="bo-file-list#toggle"
                                                data-bo-file-list-id-param="{{ item.id }}"
                                                title="{{ item.visible ? 'Hide'|trans : 'Show'|trans }}"
                                                data-label-show="{{ 'Show'|trans }}"
                                                data-label-hide="{{ 'Hide'|trans }}"
                                                data-testid="bo-file-toggle-{{ item.id }}">
                                            <i class="bi bi-eye{% if not item.visible %}-slash{% endif %}" aria-hidden="true"></i>
                                        </button>
                                    {% endif %}
                                    {% if can_delete %}
                                        <button type="button" class="btn btn-outline-danger" data-action="bo-file-list#delete"
                                                data-bo-file-list-id-param="{{ item.id }}"
                                                title="{{ 'Delete'|trans }}"
                                                data-testid="bo-file-delete-{{ item.id }}">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
