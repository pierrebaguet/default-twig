{# The show/hide and delete buttons of a media card, image or video alike. #}
<div class="btn-group btn-group-sm">
    {% if can_update %}
        <button type="button" class="btn btn-outline-secondary" data-action="bo-file-list#toggle"
                data-bo-file-list-id-param="{{ item.id }}"
                title="{{ item.visible ? 'Hide'|trans : 'Show'|trans }}"
                aria-label="{{ item.visible ? 'Hide'|trans : 'Show'|trans }}"
                data-label-show="{{ 'Show'|trans }}"
                data-label-hide="{{ 'Hide'|trans }}"
                data-testid="{{ testid_prefix }}-toggle-{{ item.id }}">
            <i class="bi bi-eye{% if not item.visible %}-slash{% endif %}" aria-hidden="true"></i>
        </button>
    {% endif %}
    {% if can_delete %}
        <button type="button" class="btn btn-outline-danger" data-action="bo-file-list#delete"
                data-bo-file-list-id-param="{{ item.id }}"
                title="{{ 'Delete'|trans }}"
                aria-label="{{ 'Delete'|trans }}"
                data-testid="{{ testid_prefix }}-delete-{{ item.id }}">
            <i class="bi bi-trash" aria-hidden="true"></i>
        </button>
    {% endif %}
</div>
