{{ safe_hook(kind == 'image' ? 'tab-image.top' : 'tab-document.top', { id: parent_id, type: parent_type }) }}

{% set with_videos = video_form is defined and video_form is not null %}
{% if kind == 'image' and has_hook('item.edition.images') %}
{{ safe_hook('item.edition.images', { itemType: parent_type, itemId: parent_id, resource: 'admin.' ~ parent_type }) }}
{# A module that owns the images tab shows its own images: the videos of the product
   then get a panel of their own, so that they can still be added and arranged. #}
{% if with_videos %}
    {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\File\\VideoController::videoForm', { productId: parent_id })) }}
{% endif %}
{% else %}
{# Two steps, top to bottom: add a medium, then arrange what the product has. On the
   images tab of a product, a video is added next to the images and lands in the same
   grid: the two forms refresh the one list below them. #}
<div class="bo-file-upload" data-controller="bo-file-upload{% if with_videos %} bo-video-form{% endif %}"
     data-bo-file-upload-save-url-value="{{ path(urls.save, { parentType: parent_type, parentId: parent_id }) }}"
     data-bo-file-upload-list-url-value="{{ path(urls.list, { parentType: parent_type, parentId: parent_id }) }}"
     data-bo-file-upload-token-value="{{ assignToken() }}"
     {% if with_videos %}
     data-bo-video-form-list-url-value="{{ path(urls.list, { parentType: parent_type, parentId: parent_id }) }}"
     data-bo-video-form-added-message-value="{{ 'The video was added.'|trans }}"
     data-bo-video-form-failed-message-value="{{ 'This video could not be added.'|trans }}"
     data-testid="bo-video-panel"
     {% endif %}>

    <div class="card mb-3">
        <div class="card-header">
            {% if with_videos %}{{ 'Add a medium'|trans }}{% elseif kind == 'image' %}{{ 'Add images'|trans }}{% else %}{{ 'Add documents'|trans }}{% endif %}
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="{% if with_videos %}col-lg-4{% else %}col-12{% endif %}">
                    <div class="border rounded p-3 h-100 d-flex flex-column">
                        {% if with_videos %}
                            <h3 class="h6 mb-3"><i class="bi bi-image me-1" aria-hidden="true"></i> {{ 'An image'|trans }}</h3>
                        {% endif %}
                        <form method="post" enctype="multipart/form-data" class="d-flex flex-column flex-grow-1"
                              data-testid="bo-file-upload-form-{{ kind }}"
                              data-action="submit->bo-file-upload#submit">
                            {% set upload_id = 'bo-file-upload-input-' ~ kind ~ '-' ~ parent_type ~ '-' ~ parent_id %}
                            <div class="bo-field-grid">
                                <div class="bo-field bo-field--12">
                                    <label class="form-label" for="{{ upload_id }}">
                                        {% if kind == 'image' %}{{ 'Image file'|trans }}{% else %}{{ 'Document file'|trans }}{% endif %}
                                    </label>
                                    <input type="file" name="file" class="form-control" required
                                           id="{{ upload_id }}"
                                           data-bo-file-upload-target="input"
                                           aria-describedby="{{ upload_id }}-help"
                                           accept="{{ kind == 'image' ? 'image/*' : '*' }}">
                                    <div class="bo-field-grid__help" id="{{ upload_id }}-help">{{ 'Added at the end of the list; drag it where it belongs.'|trans }}</div>
                                </div>
                            </div>
                            <div class="mt-auto pt-3 border-top d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary" data-testid="bo-file-upload-submit-{{ kind }}">
                                    <i class="bi bi-cloud-upload" aria-hidden="true"></i>
                                    {% if kind == 'image' %}{{ 'Upload images'|trans }}{% else %}{{ 'Upload documents'|trans }}{% endif %}
                                </button>
                            </div>
                        </form>
                        <div class="mt-2" data-bo-file-upload-target="status" hidden></div>
                    </div>
                </div>
                {% if with_videos %}
                    <div class="col-lg-8">
                        <div class="border rounded p-3 h-100 d-flex flex-column">
                            <h3 class="h6 mb-3"><i class="bi bi-play-btn me-1" aria-hidden="true"></i> {{ 'A video'|trans }}</h3>
                            <div class="flex-grow-1 d-flex flex-column" data-bo-video-form-target="form">
                                {% include '@BackOfficeDefaultTwig/file/_video_add_fields.html.twig' with { product_id: parent_id, form: video_form } only %}
                            </div>
                            {# Outside the swapped fragment, so what it says survives the answer it announces. #}
                            <div class="mt-2" role="status" aria-live="polite" data-bo-video-form-target="status" data-testid="bo-video-status"></div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>{% if with_videos %}{{ 'Images and videos of the product'|trans }}{% elseif kind == 'image' %}{{ 'Images'|trans }}{% else %}{{ 'Documents'|trans }}{% endif %}</span>
            {% if kind == 'image' %}
                <span class="small text-muted fw-normal">
                    <i class="bi bi-arrows-move" aria-hidden="true"></i>
                    {{ 'Drag a card to change the order.'|trans }}
                    {% if with_videos %}{{ 'Images and videos share one order.'|trans }}{% endif %}
                </span>
            {% endif %}
        </div>
        <div class="card-body" data-bo-file-upload-target="list"{% if with_videos %} data-bo-video-form-target="list"{% endif %}>
        {% include '@BackOfficeDefaultTwig/file/_list.html.twig' with {
            kind: kind,
            parent_type: parent_type,
            parent_id: parent_id,
            items: [],
            can_update: true,
            can_delete: true,
            urls: urls,
            with_videos: with_videos,
        } only %}
        </div>
    </div>
</div>
{% endif %}

{{ safe_hook(kind == 'image' ? 'tab-image.bottom' : 'tab-document.bottom', { id: parent_id, type: parent_type }) }}
