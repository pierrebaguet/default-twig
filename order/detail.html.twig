{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Order'|trans }} #{{ order.ref }}{% endblock %}
{% block body_testid %}order-detail{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.order.list') }}">{{ 'Orders'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">#{{ order.ref }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('order-edit.top', { order: order.id }) }}

    {% set extra_tabs = hook_block('order.tab', { order: order.id, id: order.id }) %}

    <div class="container-fluid" data-testid="order-detail-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-start mb-3">
            <div>
                <h1 class="h3 mb-1">{{ 'Order'|trans }} <small class="text-muted">#{{ order.ref }}</small></h1>
                <div class="d-flex gap-2 align-items-center small text-muted">
                    {% if current_status %}
                        <span class="badge" style="background-color: {{ current_status.color }}; color: #fff;" data-testid="order-status-badge">{{ current_status.title }}</span>
                    {% endif %}
                    {% if order.createdAt %}
                        <span data-testid="order-created-at"><i class="bi bi-calendar3"></i> {{ order.createdAt|date('d/m/Y H:i') }}</span>
                    {% endif %}
                </div>
                {#- In the header, not in a tab: changing the status is the most frequent action on an order. -#}
                <form action="{{ path('admin.order.update.status', { order_id: order.id }) }}" method="post" class="mt-2" data-testid="order-status-form">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <label class="form-label small mb-0" for="order-status-select">{{ 'Order status'|trans }}</label>
                        <div class="input-group input-group-sm w-auto">
                            <select id="order-status-select" name="status_id" class="form-select" data-testid="order-status-select" {% if allowed_statuses|length == 0 %}disabled{% endif %}>
                                {#- The current status first, so that submitting unchanged is a no-op; then only what the graph allows. -#}
                                <option value="{{ order.statusId }}" selected>{{ order.orderStatus.title }}</option>
                                {% for s in allowed_statuses %}
                                    <option value="{{ s.id }}">{{ s.title }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-primary" data-testid="order-status-submit" {% if allowed_statuses|length == 0 %}disabled{% endif %}>{{ 'Update'|trans }}</button>
                        </div>
                    </div>
                    {% if not status_is_free %}
                        <div class="form-text" data-testid="order-status-restricted-hint">
                            {% if allowed_statuses|length == 0 %}
                                {{ 'No transition is allowed from the current status.'|trans }}
                            {% else %}
                                {{ 'Only the statuses allowed from the current status are listed.'|trans }}
                            {% endif %}
                        </div>
                    {% endif %}
                </form>
            </div>
            <div class="d-flex gap-2 flex-wrap" data-testid="order-actions">
                {% include '@BackOfficeDefaultTwig/_prev_next_buttons.html.twig' with {
                    prev_url: prev_url|default(null),
                    next_url: next_url|default(null),
                    prev_label: 'Edit previous order'|trans,
                    next_label: 'Edit next order'|trans,
                    testid: 'order',
                } only %}
                <div class="btn-group" data-controller="bo-print-iframe" data-bo-print-iframe-url-value="{{ invoice_url }}" data-bo-print-iframe-name-value="order-invoice">
                    <a href="{{ invoice_url }}" target="_blank" class="btn btn-outline-secondary" data-testid="order-invoice-link" title="{{ 'View invoice PDF'|trans }}">
                        <i class="bi bi-file-pdf" aria-hidden="true"></i> {{ 'Invoice'|trans }}
                    </a>
                    <button type="button" class="btn btn-outline-secondary" data-action="bo-print-iframe#print" data-testid="order-invoice-print" title="{{ 'Print invoice'|trans }}">
                        <i class="bi bi-printer" aria-hidden="true"></i>
                    </button>
                    <a href="{{ invoice_download_url }}" class="btn btn-outline-secondary" data-testid="order-invoice-download" title="{{ 'Download invoice as PDF'|trans }}">
                        <i class="bi bi-download" aria-hidden="true"></i>
                    </a>
                </div>
                <div class="btn-group" data-controller="bo-print-iframe" data-bo-print-iframe-url-value="{{ delivery_url }}" data-bo-print-iframe-name-value="order-delivery">
                    <a href="{{ delivery_url }}" target="_blank" class="btn btn-outline-secondary" data-testid="order-delivery-link" title="{{ 'View purchase order as PDF'|trans }}">
                        <i class="bi bi-file-pdf" aria-hidden="true"></i> {{ 'Delivery slip'|trans }}
                    </a>
                    <button type="button" class="btn btn-outline-secondary" data-action="bo-print-iframe#print" data-testid="order-delivery-print" title="{{ 'Print purchase order'|trans }}">
                        <i class="bi bi-printer" aria-hidden="true"></i>
                    </button>
                    <a href="{{ delivery_download_url }}" class="btn btn-outline-secondary" data-testid="order-delivery-download" title="{{ 'Download purchase order as PDF'|trans }}">
                        <i class="bi bi-download" aria-hidden="true"></i>
                    </a>
                </div>
                {% if cancel_status_id > 0 and not is_canceled and can_cancel %}
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#order-cancel-modal" data-testid="order-cancel-btn">
                        <i class="bi bi-x-circle" aria-hidden="true"></i> {{ 'Cancel order'|trans }}
                    </button>
                {% endif %}
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8" data-controller="bo-ajax-tab">
                <ul class="nav nav-tabs mb-3" id="order-detail-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-cart-toggle" data-bs-toggle="tab" data-bs-target="#tab-cart" type="button" role="tab" aria-controls="tab-cart" aria-selected="true" data-testid="order-tab-cart">
                            <i class="bi bi-bag" aria-hidden="true"></i> {{ 'Ordered products'|trans }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-bill-toggle" data-bs-toggle="tab" data-bs-target="#tab-bill" type="button" role="tab" aria-controls="tab-bill" data-testid="order-tab-bill">
                            <i class="bi bi-receipt" aria-hidden="true"></i> {{ 'Invoice and Delivery'|trans }}
                        </button>
                    </li>
                    {% for block in extra_tabs %}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#{{ block.id }}"
                                    {% if block.href is defined and block.href %}data-href="{{ block.href }}"{% endif %}
                                    type="button" role="tab" data-testid="order-tab-{{ block.id }}">{{ block.title }}</button>
                        </li>
                    {% endfor %}
                    {% if has_hook('order.tab-content') %}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-modules-toggle" data-bs-toggle="tab" data-bs-target="#tab-modules" type="button" role="tab" aria-controls="tab-modules" data-testid="order-tab-modules">
                                <i class="bi bi-puzzle" aria-hidden="true"></i> {{ 'Modules'|trans }}
                            </button>
                        </li>
                    {% endif %}
                </ul>

                <div class="tab-content">

                <div class="tab-pane fade show active" id="tab-cart" role="tabpanel" aria-labelledby="tab-cart-toggle">
                {{ safe_hook('order-edit.cart-top', { order_id: order.id, location: 'order-edit-cart-top' }) }}

                {% set order_rows = [] %}
                {% for item in order_items %}
                    {% set product_html %}
                        <div>
                            {% if item.product_id %}
                                <a href="{{ path('admin.products.update', { product_id: item.product_id }) }}" class="text-decoration-none" data-testid="order-item-product-link"><code>{{ item.ref }}</code> &mdash; <strong>{{ item.title }}</strong></a>
                            {% else %}
                                <code>{{ item.ref }}</code> &mdash; <strong>{{ item.title }}</strong>
                            {% endif %}
                            {% if item.virtual %}
                                <i class="bi bi-download text-muted" title="{{ 'Virtual product'|trans }}" aria-hidden="true"></i>
                            {% endif %}
                        </div>
                        {% if item.pse_ref and item.pse_ref != item.ref %}
                            <small class="text-muted d-block">{{ 'Combination reference'|trans }}: <code>{{ item.pse_ref }}</code></small>
                        {% endif %}
                        {% if item.gtin %}
                            <small class="text-muted d-block" data-testid="order-item-gtin">{{ 'GTIN'|trans }}: <code>{{ item.gtin }}</code></small>
                        {% endif %}
                        {% if item.mpn %}
                            <small class="text-muted d-block" data-testid="order-item-mpn">{{ 'Manufacturer part number'|trans }}: <code>{{ item.mpn }}</code></small>
                        {% endif %}
                        {% if item.combinations|length > 0 %}
                            <dl class="row mb-0 mt-1 small">
                                {% for combination in item.combinations %}
                                    <dt class="col-sm-4 fw-normal text-muted">{{ combination.attribute_title }}</dt>
                                    <dd class="col-sm-8 mb-0">{{ combination.attribute_av_title }}</dd>
                                {% endfor %}
                            </dl>
                        {% endif %}
                        {{ safe_hook('order-edit.product-list', { order_id: order.id, order_product_id: item.id, location: 'order-product-list' }) }}
                    {% endset %}
                    {% set order_rows = order_rows|merge([{
                        'id': item.id,
                        'product_html': product_html,
                        'price': item.price|number_format(2, '.', ' ') ~ ' ' ~ currency.symbol,
                        'tax': item.tax|number_format(2, '.', ' ') ~ ' ' ~ currency.symbol,
                        'unit_taxed_price': item.unit_taxed_price|number_format(2, '.', ' ') ~ ' ' ~ currency.symbol,
                        'quantity': item.quantity,
                        'line_ht': item.line_ht|number_format(2, '.', ' ') ~ ' ' ~ currency.symbol,
                        'line_tax': item.line_tax|number_format(2, '.', ' ') ~ ' ' ~ currency.symbol,
                        'line_ttc': '<span class="fw-semibold" dir="ltr">' ~ item.line_ttc|number_format(2, '.', ' ') ~ ' ' ~ currency.symbol ~ '</span>',
                        '_attrs': { 'data-order-product-id': item.id, 'data-testid': 'order-item-row' },
                    }]) %}
                {% endfor %}

                {{ safe_hook('order-edit.before-order-product-list', { order_id: order.id, location: 'before-order-product-list' }) }}
                {{ component('BoDataTable', {
                    id: 'order-items',
                    caption: 'Order items'|trans ~ ' — ' ~ 'Prices in %currency'|trans({'%currency': currency.symbol}),
                    columns: [
                        column_html('product_html', 'Product'|trans),
                        column('quantity', 'Quantity'|trans, 'end'),
                        column('price', 'Unit price (excl. tax)'|trans, 'end', hideBelow: 'lg', leftToRight: true),
                        column('tax', 'Tax'|trans, 'end', hideBelow: 'xl', leftToRight: true),
                        column('unit_taxed_price', 'Unit price (incl. tax)'|trans, 'end', hideBelow: 'lg', leftToRight: true),
                        column('line_ht', 'Line total (excl. tax)'|trans, 'end', hideBelow: 'xl', leftToRight: true),
                        column('line_tax', 'Line tax'|trans, 'end', hideBelow: 'xl', leftToRight: true),
                        column_html('line_ttc', 'Line total (incl. tax)'|trans, 'end'),
                    ],
                    rows: order_rows,
                    emptyMessage: 'No item.'|trans,
                    extraColumnsHeaderHook: 'order-edit.order-product-table-header',
                    extraColumnsHook: 'order-edit.order-product-table-row',
                    rowHookArgs: { order_product_id: 'id' },
                    headerHookContext: { location: 'order_edit_table_header' },
                    rowHookContext: { location: 'order_edit_table_row' },
                }) }}
                {{ safe_hook('order-edit.after-order-product-list', { order_id: order.id, location: 'after-order-product-list' }) }}

                {% if order_items|length > 0 %}
                    <div class="card mb-3">
                        <div class="card-body py-2 d-flex justify-content-end">
                            <span class="fw-bold me-3">{{ 'Items subtotal (incl. tax)'|trans }}</span>
                            <span dir="ltr" class="fw-bold" data-testid="order-items-subtotal">{{ totals.subtotal_ttc|number_format(2, '.', ' ') }} {{ currency.symbol }}</span>
                        </div>
                        {% if items_last_page|default(1) > 1 %}
                            <div class="card-footer">
                                {{ component('BoPagination', {
                                    route: 'admin.order.update.view',
                                    currentPage: items_page,
                                    lastPage: items_last_page,
                                    routeParams: { order_id: order.id, history_page: history_page },
                                    pageParam: 'items_page',
                                    ariaLabel: 'Order items pagination'|trans,
                                    testid: 'order-items',
                                    spacing: '',
                                }) }}
                            </div>
                        {% endif %}
                    </div>
                {% elseif items_last_page|default(1) > 1 %}
                    <div class="card mb-3">
                        <div class="card-footer">
                            {{ component('BoPagination', {
                                route: 'admin.order.update.view',
                                currentPage: items_page,
                                lastPage: items_last_page,
                                routeParams: { order_id: order.id, history_page: history_page },
                                pageParam: 'items_page',
                                ariaLabel: 'Order items pagination'|trans,
                                testid: 'order-items',
                                spacing: '',
                            }) }}
                        </div>
                    </div>
                {% endif %}

                <div class="card mb-3" data-testid="order-taxes-breakdown">
                    <div class="card-header">{{ 'Taxes detail'|trans }}</div>
                    <div class="card-body py-2">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="text-muted text-uppercase small mb-2">{{ 'Items taxes'|trans }}</h6>
                                <ul class="list-group list-group-flush small" data-testid="order-taxes-items">
                                    {% for label, amount in totals.items_taxes %}
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span>{{ label }}</span>
                                            <strong dir="ltr">{{ amount|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                                        </li>
                                    {% else %}
                                        <li class="list-group-item px-0 text-muted">{{ 'None'|trans }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted text-uppercase small mb-2">{{ 'Shipping taxes'|trans }}</h6>
                                <ul class="list-group list-group-flush small" data-testid="order-taxes-shipping">
                                    {% if totals.postage_tax > 0 %}
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span>{{ totals.postage_tax_rule_title|default('-') }}</span>
                                            <strong dir="ltr">{{ totals.postage_tax|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                                        </li>
                                    {% else %}
                                        <li class="list-group-item px-0 text-muted">{{ 'None'|trans }}</li>
                                    {% endif %}
                                </ul>
                                {% if totals.discount_tax > 0 %}
                                    <h6 class="text-muted text-uppercase small mt-3 mb-2">{{ 'Discount tax'|trans }}</h6>
                                    <ul class="list-group list-group-flush small" data-testid="order-taxes-discount">
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span>{{ 'Average rate'|trans }}</span>
                                            <strong dir="ltr">- {{ totals.discount_tax|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                                        </li>
                                    </ul>
                                {% endif %}
                            </div>
                        </div>
                        <hr class="my-3">
                        <div class="d-flex justify-content-between">
                            <strong>{{ 'Taxes total'|trans }}</strong>
                            <strong dir="ltr" data-testid="order-taxes-total">{{ totals.total_tax|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </div>
                    </div>
                </div>
                {{ safe_hook('order-edit.cart-bottom', { order_id: order.id, location: 'order-edit-cart-bottom' }) }}
                </div>{# /tab-cart #}

                <div class="tab-pane fade" id="tab-bill" role="tabpanel" aria-labelledby="tab-bill-toggle">
                {{ safe_hook('order-edit.bill-top', { order_id: order.id, location: 'order-edit-bill-top' }) }}
                <div class="card mb-3">
                    <div class="card-header">{{ 'Order management'|trans }}</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="order-delivery-ref-input">{{ 'Tracking reference'|trans }}</label>
                                <form action="{{ path('admin.order.update.deliveryRef', { order_id: order.id }) }}" method="post" class="d-flex gap-2" data-testid="order-delivery-ref-form">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <input type="text" id="order-delivery-ref-input" name="delivery_ref" value="{{ order.deliveryRef }}" class="form-control" placeholder="{{ 'Tracking number'|trans }}" data-testid="order-delivery-ref-input">
                                    <button type="submit" class="btn btn-primary flex-shrink-0" data-testid="order-delivery-ref-submit">{{ 'Update'|trans }}</button>
                                </form>
                            </div>
                            {% if (can_force_status and forced_only_statuses|length > 0) or forced_status_changes|length > 0 %}
                            <div class="col-md-6">
                                {% if can_force_status and forced_only_statuses|length > 0 %}
                                    <details data-testid="order-status-force">
                                        <summary class="small text-danger">{{ 'Force a status outside the allowed transitions'|trans }}</summary>
                                        <form action="{{ path('admin.order.update.status', { order_id: order.id }) }}" method="post" class="mt-2" data-testid="order-status-force-form">
                                            <input type="hidden" name="_token" value="{{ token }}">
                                            <input type="hidden" name="force" value="1">
                                            <div class="input-group">
                                                <select name="status_id" class="form-select border-danger" required aria-label="{{ 'Status to force'|trans }}" data-testid="order-status-force-select">
                                                    {#- Never preselected: forcing is always a deliberate pick. -#}
                                                    <option value="" selected>{{ 'Choose the status to force'|trans }}</option>
                                                    {% for s in forced_only_statuses %}
                                                        <option value="{{ s.id }}">{{ s.title }}</option>
                                                    {% endfor %}
                                                </select>
                                                <button type="submit" class="btn btn-outline-danger" data-testid="order-status-force-submit">{{ 'Force'|trans }}</button>
                                            </div>
                                            <div class="form-text text-danger">{{ 'The transition graph is bypassed for this order only. The override is written to the administration log.'|trans }}</div>
                                        </form>
                                    </details>
                                {% endif %}
                                {% if forced_status_changes|length > 0 %}
                                    <div class="mt-3" data-testid="order-forced-status-changes">
                                        <h3 class="h6 mb-2">{{ 'Statuses forced on this order'|trans }}</h3>
                                        <ul class="list-group list-group-flush small">
                                            {% for change in forced_status_changes %}
                                                <li class="list-group-item d-flex flex-wrap column-gap-2 px-0">
                                                    <span class="text-muted">{{ change.created_at ? change.created_at|date('d/m/Y H:i') : '' }}</span>
                                                    {#- Who forced it is read from the administration log, and only shown to an administrator allowed to read it. -#}
                                                    {% if change.admin %}<span data-testid="order-forced-status-change-admin">{{ change.admin }}</span>{% endif %}
                                                    <span>
                                                        <span class="fw-semibold">{{ change.from }}</span>
                                                        <i class="bi bi-arrow-right mx-1" aria-hidden="true"></i>
                                                        <span class="fw-semibold">{{ change.to }}</span>
                                                    </span>
                                                </li>
                                            {% endfor %}
                                            {% if forced_status_changes_hidden > 0 %}
                                                <li class="list-group-item text-muted px-0" data-testid="order-forced-status-changes-truncated">
                                                    {{ '%count% older override(s) are not listed here.'|trans({'%count%': forced_status_changes_hidden}) }}
                                                </li>
                                            {% endif %}
                                        </ul>
                                    </div>
                                {% endif %}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        {% include '@BackOfficeDefaultTwig/order/_address_card.html.twig' with {
                            kind: 'invoice',
                            title: 'Invoice address'|trans,
                            address: order_addresses.invoice,
                            customer_email: customer ? customer.email : null,
                            currency_symbol: currency.symbol,
                            hook: null,
                        } only %}
                    </div>
                    <div class="col-md-6">
                        {% include '@BackOfficeDefaultTwig/order/_address_card.html.twig' with {
                            kind: 'delivery',
                            title: 'Delivery address'|trans,
                            address: order_addresses.delivery,
                            customer_email: null,
                            currency_symbol: currency.symbol,
                            hook: safe_hook('order-edit.bill-delivery-address', { order_id: order.id, module: delivery.module_id, module_id: delivery.module_id }),
                        } only %}
                    </div>
                </div>
                {{ safe_hook('order-edit.bill-bottom', { order_id: order.id, location: 'order-edit-bill-bottom' }) }}
                </div>{# /tab-bill #}

                {% for block in extra_tabs %}
                    <div class="tab-pane fade" id="{{ block.id }}" role="tabpanel">
                        {% if block.href is defined and block.href %}
                            <div class="text-center"><span class="loading">{{ 'Please wait, loading'|trans }}</span></div>
                        {% else %}
                            {{ block.content|raw }}
                        {% endif %}
                    </div>
                {% endfor %}

                {% if has_hook('order.tab-content') %}
                    <div class="tab-pane fade" id="tab-modules" role="tabpanel" aria-labelledby="tab-modules-toggle">
                        {{ hook_cards('order.tab-content', { order: order.id, order_id: order.id, location: 'order-edit', view: 'order' }) }}
                    </div>
                {% endif %}

                </div>{# /tab-content #}

                {% if history_enabled %}
                    {% include '@BackOfficeDefaultTwig/order/_history_card.html.twig' with {
                        order: order,
                        entries: history_entries,
                        total: history_total,
                        page: history_page,
                        last_page: history_last_page,
                        can_add_note: history_can_add_note,
                        note_max_length: history_note_max_length,
                        token: token,
                        items_page: items_page,
                    } only %}
                {% endif %}
            </div>

            <div class="col-lg-4">
                <div class="card mb-3" data-testid="order-totals">
                    <div class="card-header">{{ 'Totals'|trans }}</div>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Total without tax'|trans }}</span>
                            <strong dir="ltr" data-testid="order-totals-subtotal-ht">{{ totals.subtotal_ht|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Total with taxes before discount'|trans }}</span>
                            <strong dir="ltr">{{ totals.subtotal_ttc|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        {% if totals.discount > 0 %}
                            <li class="list-group-item d-flex justify-content-between text-danger">
                                <span>{{ 'Discount with taxes'|trans }}</span>
                                <strong dir="ltr" data-testid="order-totals-discount">- {{ totals.discount|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                            </li>
                        {% endif %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Total with taxes after discount'|trans }}</span>
                            <strong dir="ltr" data-testid="order-totals-subtotal-ttc">{{ (totals.subtotal_ttc - totals.discount)|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Shipping with taxes'|trans }}</span>
                            <strong dir="ltr" data-testid="order-totals-postage">{{ totals.postage_ttc|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between bg-light">
                            <span class="fw-bold">{{ 'Order total with taxes'|trans }}</span>
                            <strong dir="ltr" data-testid="order-totals-grand">{{ totals.grand_total|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between text-muted">
                            <span>{{ 'Total weight'|trans }}</span>
                            <span data-testid="order-totals-weight">{{ weight|number_format(2, '.', ' ') }} {{ 'kg'|trans }}</span>
                        </li>
                    </ul>
                </div>

                {% if coupons|length > 0 %}
                    <div class="card mb-3" data-testid="order-coupons">
                        <div class="card-header">{{ 'Coupons'|trans }}</div>
                        <ul class="list-group list-group-flush small">
                            {% for coupon in coupons %}
                                <li class="list-group-item d-flex justify-content-between">
                                    <span><code>{{ coupon.code }}</code>{% if coupon.title %} <span class="text-muted">- {{ coupon.title }}</span>{% endif %}</span>
                                    <strong dir="ltr" class="text-danger">- {{ coupon.amount|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% if customer %}
                    <div class="card mb-3" data-testid="order-customer">
                        <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                            <span>{{ 'Customer'|trans }}</span>
                            <a href="{{ customer.edit_url }}" class="btn btn-sm btn-outline-secondary" data-testid="order-customer-edit">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Open'|trans }}
                            </a>
                        </div>
                        <div class="card-body small">
                            <p class="mb-1"><strong>{{ customer.firstname }} {{ customer.lastname }}</strong>{% if customer.ref %} <span class="text-muted">({{ customer.ref }})</span>{% endif %}</p>
                            {% if customer.email %}
                                <p class="mb-0"><a href="mailto:{{ customer.email }}" data-testid="order-customer-email">{{ customer.email }}</a></p>
                            {% endif %}
                            {{ safe_hook('order-edit.customer-information-bottom', { order_id: order.id, customer_id: customer.id }) }}
                        </div>
                    </div>
                {% endif %}

                {% if gift.services|length > 0 or gift.message %}
                    <div class="card mb-3" data-testid="order-gift">
                        <div class="card-header">{{ 'Gift'|trans }}</div>
                        <div class="card-body small">
                            {% for service in gift.services %}
                                <p class="mb-1">
                                    <strong>{{ service.title }}</strong>
                                    {% if service.tax_rule_title %}
                                        <span class="text-muted">({{ service.tax_rule_title }})</span>
                                    {% endif %}
                                </p>
                            {% endfor %}
                            {% if gift.message %}
                                <p class="mb-1 text-muted">{{ 'Message for the recipient'|trans }}</p>
                                {# Typed by a visitor: printed as text, never as markup. #}
                                <blockquote class="mb-0 border-start ps-2" data-testid="order-gift-message">{{ gift.message|nl2br }}</blockquote>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {% if consents|length > 0 %}
                    <div class="card mb-3" data-testid="order-consents">
                        <div class="card-header">{{ 'Consents'|trans }}</div>
                        <ul class="list-group list-group-flush small">
                            {% for consent in consents %}
                                <li class="list-group-item d-flex justify-content-between align-items-start gap-2">
                                    <span>
                                        {{ consent.title }}
                                        {% if consent.description %}
                                            <span class="d-block text-muted">{{ consent.description }}</span>
                                        {% endif %}
                                    </span>
                                    <span class="text-end">
                                        {% if consent.accepted %}
                                            <span class="badge text-bg-success">{{ 'Accepted'|trans }}</span>
                                        {% else %}
                                            <span class="badge text-bg-danger">{{ 'Refused'|trans }}</span>
                                        {% endif %}
                                        {% if consent.answered_at %}
                                            <div class="text-muted">{{ consent.answered_at|date('d/m/Y H:i') }}</div>
                                        {% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <div class="card mb-3" data-testid="order-payment">
                    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <span>{{ 'Payment'|trans }}</span>
                        {% if payment.is_paid %}
                            <span class="badge text-bg-success">{{ 'Paid'|trans }}</span>
                        {% endif %}
                    </div>
                    <div class="card-body small">
                        <p class="mb-1"><strong>{{ payment.module_title|default('-') }}</strong></p>
                        {% if payment.transaction_ref %}
                            <p class="mb-1 text-muted">{{ 'Transaction reference'|trans }}: <code>{{ payment.transaction_ref }}</code></p>
                        {% else %}
                            <p class="mb-1 text-muted">{{ 'No transaction for this order'|trans }}</p>
                        {% endif %}
                        {% if payment.invoice_ref %}
                            <p class="mb-1 text-muted">{{ 'Invoice reference'|trans }}: <code>{{ payment.invoice_ref }}</code></p>
                        {% endif %}
                        {% if payment.invoice_date %}
                            <p class="mb-1 text-muted">{{ 'Invoice date'|trans }}: {{ payment.invoice_date|date('d/m/Y') }}</p>
                        {% endif %}
                        {{ safe_hook('order-edit.payment-module-bottom', { order_id: order.id, module_id: payment.module_id }) }}
                    </div>
                </div>

                <div class="card mb-3" data-testid="order-delivery">
                    <div class="card-header">{{ 'Delivery'|trans }}</div>
                    <div class="card-body small">
                        <p class="mb-1"><strong>{{ delivery.module_title|default('-') }}</strong></p>
                        {% if delivery.module_description %}
                            <div class="text-muted small mb-2">{{ delivery.module_description|raw }}</div>
                        {% endif %}
                        {% if delivery.delivery_ref %}
                            <p class="mb-1 text-muted">{{ 'Tracking reference'|trans }}: <code>{{ delivery.delivery_ref }}</code></p>
                            {% if delivery.tracking_url|default(null) %}
                                <p class="mb-1">
                                    <a href="{{ delivery.tracking_url }}" target="_blank" rel="noopener noreferrer" data-testid="order-delivery-tracking-link">
                                        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>{{ 'Track the parcel on the carrier site'|trans }}
                                    </a>
                                </p>
                            {% endif %}
                        {% endif %}
                        {% if delivery.delivery_date %}
                            <p class="mb-1" data-testid="order-delivery-date">
                                <i class="bi bi-calendar-week me-1" aria-hidden="true"></i>{{ 'Requested delivery'|trans }}:
                                <strong>{{ delivery.delivery_date|format_date('full') }}</strong>
                                {% if delivery.delivery_slot_start %}
                                    {{ 'from %start to %end'|trans({ '%start': delivery.delivery_slot_start, '%end': delivery.delivery_slot_end }) }}
                                {% endif %}
                            </p>
                        {% endif %}
                        {{ safe_hook('order-edit.delivery-module-bottom', { order_id: order.id, module: delivery.module_id, module_id: delivery.module_id }) }}
                    </div>
                </div>

                {% if returns_enabled %}
                    {% include '@BackOfficeDefaultTwig/order/_returns_card.html.twig' with {
                        order: order,
                        order_returns: order_returns,
                        returnable_lines: returnable_lines,
                        can_create: can_create_return,
                        token: token,
                    } only %}
                {% endif %}

            </div>
        </div>
    </div>

    {% if history_enabled %}
        {% for entry in history_entries|filter(entry => entry.editable) %}
            {% include '@BackOfficeDefaultTwig/order/_history_note_edit_modal.html.twig' with {
                order: order,
                entry: entry,
                note_max_length: history_note_max_length,
                token: token,
            } only %}
        {% endfor %}
    {% endif %}

    {% if returns_enabled and can_create_return and returnable_lines is not empty %}
        {% include '@BackOfficeDefaultTwig/order/_return_open_modal.html.twig' with {
            order: order,
            returnable_lines: returnable_lines,
            return_reasons: return_reasons,
            token: token,
        } only %}
    {% endif %}

    {% if order_addresses.invoice or order_addresses.delivery %}
        {% include '@BackOfficeDefaultTwig/order/_address_modal.html.twig' with {
            order: order,
            customer_titles: customer_titles,
            countries: countries,
            states: states,
            token: token,
        } only %}
    {% endif %}

    {% if cancel_status_id > 0 and not is_canceled and can_cancel %}
        <div class="modal fade" id="order-cancel-modal" tabindex="-1" aria-hidden="true" data-testid="order-cancel-modal">
            <div class="modal-dialog">
                <form method="post" action="{{ path('admin.order.update.status', { order_id: order.id }) }}" data-testid="order-cancel-form">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Cancel order'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="status_id" value="{{ cancel_status_id }}">
                            <p>{{ 'Do you really want to cancel this order?'|trans }} <strong>#{{ order.ref }}</strong></p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                            <button type="submit" class="btn btn-danger" data-testid="order-cancel-submit">
                                <i class="bi bi-x-circle" aria-hidden="true"></i> {{ 'Cancel this order'|trans }}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}

    {{ safe_hook('order-edit.bottom', { order: order.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('order.edit-js', { order_id: order.id, location: 'order-edit-js' }) }}
{% endblock %}
