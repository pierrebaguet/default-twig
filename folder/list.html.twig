{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Folders'|trans }}{% endblock %}
{% block body_testid %}catalog-folders{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.folders.default') }}">{{ 'Folders'|trans }}</a></li>
            {% for crumb in breadcrumb_path %}
                {% if loop.last %}
                    <li class="breadcrumb-item active" aria-current="page">{{ crumb.title }}</li>
                {% else %}
                    <li class="breadcrumb-item"><a href="{{ path('admin.folders.default', { folder_id: crumb.id }) }}">{{ crumb.title }}</a></li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('folders.top') }}

    <div class="container-fluid" data-testid="folders-page">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Folders'|trans } %}
            {% block actions %}
                {% if parent_id > 0 %}
                    <a href="{{ path('admin.folders.update', { folder_id: parent_id }) }}" class="btn btn-outline-secondary btn-sm" data-testid="folder-edit-parent">
                        <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Edit this folder'|trans }}
                    </a>
                {% endif %}
                {% if is_granted('CREATE', 'admin.folder') %}
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#folder-create-modal" data-testid="folder-create-button">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        {{ 'Add a new folder'|trans }}
                    </button>
                {% endif %}
            {% endblock %}
        {% endembed %}

        {{ safe_hook('folders.caption', { location: 'folder_list_caption' }) }}

        {% if publication_enabled|default(false) %}
            <form method="get" action="{{ path('admin.folders.default') }}" class="row g-2 mb-3" data-testid="folders-publication-filter-form">
                {# Filtering must not silently reset the folder or the column the merchant sorted on. #}
                {% if parent_id > 0 %}
                    <input type="hidden" name="folder_id" value="{{ parent_id }}">
                {% endif %}
                <input type="hidden" name="order" value="{{ sort_field }}">
                <input type="hidden" name="direction" value="{{ sort_direction }}">
                <div class="col-md-4">
                    <label class="form-label" for="folders-publication-filter">{{ 'Filter by publication state'|trans }}</label>
                    <select name="publication_state" id="folders-publication-filter" class="form-select" data-testid="folders-publication-filter">
                        {% for choice in publication_state_choices %}
                            <option value="{{ choice.value }}" {% if choice.value == (publication_state ?? '') %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-secondary" type="submit" data-testid="folders-publication-filter-submit">{{ 'Filter'|trans }}</button>
                </div>
            </form>
        {% endif %}

        {% set publication_column = publication_enabled|default(false)
            ? [column_badge('publication_badge', 'Publication'|trans, publication_badge_variants, 'start', labelKey: 'publication_label')]
            : [] %}

        {{ component('BoDataTable', {
            id: 'folders',
            columns: [
                column('id', 'ID'|trans, 'start', 'id', hideBelow: 'md'),
                column_html('thumbnail_html', 'Image'|trans, 'center', hideBelow: 'md'),
                column_html('title_html', 'Title'|trans, 'start', 'title'),
            ]|merge(publication_column)|merge([
                column_toggle('visible', 'Online'|trans, 'toggle_visible_url', 'center', 'bi-check-circle-fill text-success', 'bi-circle text-secondary', 'visible'),
                column_position('position', 'Position'|trans, 'center', 'position', hideBelow: 'lg'),
                column_actions('_actions', 'Actions'|trans),
            ]),
            rows: rows,
            emptyMessage: 'No subfolder yet.'|trans,
            extraColumnsHeaderHook: 'folders.header',
            extraColumnsHook: 'folders.row',
            headerHookContext: { location: 'folder_list_header' },
            rowHookContext: { location: 'folder_list_row' },
            rowHookArgs: { folder_id: 'id' },
            sortField: sort_field,
            sortDirection: sort_direction,
            sortKeepParams: { folder_id: parent_id ?: null, publication_state: publication_state|default(null) },
            tbodyAttributes: {
                'data-controller': 'bo-sortable bo-position',
                'data-bo-sortable-url-value': update_position_url,
                'data-bo-sortable-token-value': update_position_token,
                'data-bo-sortable-param-name-value': 'folder_id',
                'data-bo-position-url-value': update_position_url,
                'data-bo-position-token-value': update_position_token,
                'data-bo-position-param-name-value': 'folder_id',
                'data-bo-position-title-value': 'Position'|trans,
                'data-bo-position-save-label-value': 'Save'|trans,
                'data-bo-position-cancel-label-value': 'Cancel'|trans,
            },
        }) }}

        {% if parent_id > 0 %}
            <section class="mt-4" data-testid="folder-contents-section">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h5 mb-0">{{ 'Contents in this folder'|trans }} <span class="badge bg-secondary">{{ content_total }}</span></h2>
                    {% if is_granted('CREATE', 'admin.content') %}
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#content-create-modal" data-testid="content-create-button">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a new content'|trans }}
                        </button>
                    {% endif %}
                </div>

                {{ safe_hook('contents.caption', { location: 'content_list_caption' }) }}

                {{ component('BoDataTable', {
                    id: 'folder-contents',
                    columns: [
                        column('id', 'ID'|trans, 'start', hideBelow: 'md'),
                        column_html('thumbnail_html', 'Image'|trans, 'center', hideBelow: 'md'),
                        column_html('title_html', 'Title'|trans, 'start'),
                    ]|merge(publication_column)|merge([
                        column_toggle('visible', 'Online'|trans, 'toggle_visible_url', 'center', 'bi-check-circle-fill text-success', 'bi-circle text-secondary', 'visible'),
                        column_position('position', 'Position'|trans, 'center', hideBelow: 'lg'),
                        column_actions('_actions', 'Actions'|trans),
                    ]),
                    rows: content_rows,
                    emptyMessage: 'No content in this folder yet.'|trans,
                    extraColumnsHeaderHook: 'contents.header',
                    extraColumnsHook: 'contents.row',
                    headerHookContext: { location: 'content_list_header' },
                    rowHookContext: { location: 'content_list_row' },
                    tbodyAttributes: {
                        'data-controller': 'bo-sortable bo-position',
                        'data-bo-sortable-url-value': content_update_position_url,
                        'data-bo-sortable-token-value': content_update_position_token,
                        'data-bo-sortable-param-name-value': 'content_id',
                        'data-bo-position-url-value': content_update_position_url,
                        'data-bo-position-token-value': content_update_position_token,
                        'data-bo-position-param-name-value': 'content_id',
                        'data-bo-position-title-value': 'Position'|trans,
                        'data-bo-position-save-label-value': 'Save'|trans,
                        'data-bo-position-cancel-label-value': 'Cancel'|trans,
                    },
                }) }}

                {% if content_pages > 1 %}
                    {{ component('BoPagination', {
                        route: 'admin.folders.default',
                        currentPage: content_current_page,
                        lastPage: content_pages,
                        routeParams: { folder_id: parent_id, publication_state: publication_state|default(null) },
                        pageParam: 'content_page',
                        ariaLabel: 'Folder contents pagination'|trans,
                        testid: 'folder-contents-pagination',
                    }) }}
                {% endif %}
            </section>
        {% endif %}
    </div>

    {{ safe_hook('folders.bottom') }}

    <div class="modal fade" id="folder-create-modal" tabindex="-1" aria-labelledby="folder-create-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                {% form_theme create_form with bo_form_themes only %}
                {{ form_start(create_form, { action: path('admin.folders.create'), method: 'post', attr: { 'data-testid': 'folder-create-form' } }) }}
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="folder-create-modal-title">{{ 'Create a new folder'|trans }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            {{ form_label(create_form.title) }}
                            {{ form_widget(create_form.title, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(create_form.title) }}
                        </div>
                        {% if create_form.visible is defined %}
                            <div class="form-check mb-3">
                                {{ form_widget(create_form.visible, { attr: { class: 'form-check-input' } }) }}
                                {{ form_label(create_form.visible, null, { label_attr: { class: 'form-check-label' } }) }}
                            </div>
                        {% else %}
                            <p class="form-text mb-3" data-testid="folder-create-draft-note">{{ 'The folder is created as a draft: publish it from its sheet.'|trans }}</p>
                        {% endif %}
                        {{ form_widget(create_form.locale) }}
                        {{ form_widget(create_form.parent) }}
                        {{ safe_hook('folder.create-form', { location: 'folder_create_form' }) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-primary" data-testid="folder-create-submit">{{ 'Create'|trans }}</button>
                    </div>
                {{ form_end(create_form) }}
            </div>
        </div>
    </div>

    {{ component('BoConfirmDialog', {
        id: 'folder-delete-modal',
        title: 'Delete folder',
        formAction: path('admin.folders.delete', list_query_params),
        message: 'Do you really want to delete this folder? Subfolders and products are not deleted but become orphaned.',
        testid: 'folder-delete',
        hook: 'folder.delete-form',
        hookContext: { location: 'folder_delete_form' },
        prefillTrigger: 'data-folder-id',
        prefillInput: 'folder_id',
    }) }}

    {% if parent_id > 0 and is_granted('CREATE', 'admin.content') %}
        <div class="modal fade" id="content-create-modal" tabindex="-1" aria-labelledby="content-create-modal-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    {% form_theme content_create_form with bo_form_themes only %}
                    {{ form_start(content_create_form, { action: path('admin.content.create'), method: 'post', attr: { 'data-testid': 'content-create-form' } }) }}
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="content-create-modal-title">{{ 'Create a new content'|trans }}</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                {{ form_label(content_create_form.title) }}
                                {{ form_widget(content_create_form.title, { attr: { class: 'form-control' } }) }}
                                {{ form_errors(content_create_form.title) }}
                            </div>
                            {% if content_create_form.visible is defined %}
                                <div class="form-check mb-3">
                                    {{ form_widget(content_create_form.visible, { attr: { class: 'form-check-input' } }) }}
                                    {{ form_label(content_create_form.visible, null, { label_attr: { class: 'form-check-label' } }) }}
                                </div>
                            {% else %}
                                <p class="form-text mb-3" data-testid="content-create-draft-note">{{ 'The content is created as a draft: publish it from its sheet.'|trans }}</p>
                            {% endif %}
                            {{ form_widget(content_create_form.locale) }}
                            {{ form_widget(content_create_form.default_folder) }}
                            {{ safe_hook('content.create-form', { location: 'content_create_form' }) }}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                            <button type="submit" class="btn btn-primary" data-testid="content-create-submit">{{ 'Create'|trans }}</button>
                        </div>
                    {{ form_end(content_create_form) }}
                </div>
            </div>
        </div>

        {{ component('BoConfirmDialog', {
            id: 'content-delete-modal',
            title: 'Delete content',
            formAction: path('admin.content.delete', list_query_params|merge({ folder_id: parent_id })),
            message: 'Do you really want to delete this content?',
            testid: 'content-delete',
            hook: 'content.delete-form',
            hookContext: { location: 'content_delete_form' },
            prefillTrigger: 'data-content-id',
            prefillInput: 'content_id',
        }) }}
    {% endif %}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('folders.js', { location: 'folders-js' }) }}
{% endblock %}
