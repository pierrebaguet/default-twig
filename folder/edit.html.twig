{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit folder'|trans }} - {{ folder.title }}{% endblock %}
{% block body_testid %}catalog-folder-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.folders.default') }}">{{ 'Folders'|trans }}</a></li>
            {% for crumb in breadcrumb_path|default([]) %}
                <li class="breadcrumb-item"><a href="{{ path('admin.folders.default', { folder_id: crumb.id }) }}">{{ crumb.title }}</a></li>
            {% endfor %}
            <li class="breadcrumb-item active" aria-current="page">{{ folder.title }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('folder-edit.top', { folder_id: folder.id }) }}

    {% set current_tab = current_tab|default('general') %}
    {% set children = children|default([]) %}
    {% set extra_tabs = hook_block('folder.tab', { folder: folder.id, id: folder.id }) %}
    {# A module tab opens like a native one when current_tab names it; an unknown tab falls back to the general one. #}
    {% set current_tab = current_tab in ['general', 'children', 'images', 'documents', 'seo', 'modules']|merge(extra_tabs|map(block => block.id)) ? current_tab : 'general' %}

    <div class="container-fluid" data-testid="folder-edit-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Folder'|trans }} <small class="text-muted">#{{ folder.id }}</small></h1>
            <div class="d-flex flex-wrap gap-2">
                {% include '@BackOfficeDefaultTwig/fragments/publication-preview.html.twig' with {
                    type: 'folder',
                    preview_link: preview_link|default(null),
                    preview_url: preview_url|default(null),
                    title: 'Preview folder page'|trans,
                } only %}
                <a href="{{ path('admin.folders.default', { folder_id: folder.parent }) }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back'|trans }}
                </a>
            </div>
        </div>

        <div class="bo-tab-bar">
            <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'general' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" data-testid="folder-tab-general">
                    {{ 'General'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'children' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-children" type="button" data-testid="folder-tab-children">
                    {{ 'Subfolders'|trans }} <span class="badge bg-secondary">{{ children|length }}</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'images' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-images" type="button" data-testid="folder-tab-images">
                    {{ 'Images'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'documents' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button" data-testid="folder-tab-documents">
                    {{ 'Documents'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'seo' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-seo" type="button" data-testid="folder-tab-seo">
                    {{ 'SEO'|trans }}
                </button>
            </li>
            {% for block in extra_tabs %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link {% if current_tab == block.id %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#{{ block.id }}"
                            {% if block.href is defined and block.href %}data-href="{{ block.href }}"{% endif %}
                            type="button" data-testid="folder-tab-{{ block.id }}">{{ block.title }}</button>
                </li>
            {% endfor %}
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'modules' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-modules" type="button" data-testid="folder-tab-modules">
                    {{ 'Modules'|trans }}
                </button>
            </li>
        </ul>
            <div class="bo-tab-bar__aside">
                {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
            </div>
        </div>

        <div class="tab-content">
            <div class="tab-pane fade {% if current_tab == 'general' %}show active{% endif %}" id="tab-general" role="tabpanel">
                {% form_theme form with bo_form_themes only %}
                {{ form_start(form, { action: path('admin.folders.save', { folder_id: folder.id }), method: 'post', attr: { 'data-testid': 'folder-edit-form' } }) }}
                    <input type="hidden" name="folder_id" value="{{ folder.id }}">

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                {{ form_label(form.title) }}
                                {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
                                {{ form_errors(form.title) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.chapo) }}
                                {{ form_widget(form.chapo, { attr: { class: 'form-control', rows: 3 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.description) }}
                                {{ form_widget(form.description, { attr: { class: 'form-control', rows: 8 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.postscriptum) }}
                                {{ form_widget(form.postscriptum, { attr: { class: 'form-control', rows: 3 } }) }}
                            </div>
                        </div>
                        <div class="col-md-4">
                            {{ safe_hook('folder.modification.form-right.top', { folder_id: folder.id }) }}
                            {% if publication|default(null) %}
                                {% include '@BackOfficeDefaultTwig/fragments/publication-panel.html.twig' with { publication: publication } only %}
                            {% else %}
                                <div class="form-check mb-3">
                                    {{ form_widget(form.visible, { attr: { class: 'form-check-input' } }) }}
                                    {{ form_label(form.visible, null, { label_attr: { class: 'form-check-label' } }) }}
                                </div>
                            {% endif %}
                            <div class="mb-3">
                                {{ form_label(form.parent) }}
                                {{ form_widget(form.parent, { attr: { class: 'form-control' } }) }}
                            </div>
                            {{ safe_hook('folder.modification.form-right.bottom', { folder_id: folder.id }) }}
                            {% set edit_toolbar = {
                                closeUrl: path('admin.folders.default', { folder_id: folder.parent }),
                                closeFirst: false,
                                closeIcon: 'bi-x-lg',
                                saveIcon: 'bi-check-lg',
                                saveCloseIcon: 'bi-x-lg',
                                saveVariant: 'success',
                                saveCloseVariant: 'info',
                                iconAfterLabel: true,
                                align: 'start'
                            } %}
                            {% set edit_dates = 'Folder created on %date_create. Last modification on %date_change'|trans({
                                '%date_create': folder.createdAt ? folder.createdAt|format_datetime('medium', 'short') : '-',
                                '%date_change': folder.updatedAt ? folder.updatedAt|format_datetime('medium', 'short') : '-',
                            }) %}
                            {{ component('BoSaveModeToolbar', edit_toolbar|merge({ wrapperClass: 'mb-2', testid: 'folder-edit-top' })) }}
                            <p class="small text-muted mb-3" data-testid="folder-edit-dates-top">{{ edit_dates }}</p>
                        </div>
                    </div>
                    {{ form_widget(form.id) }}
                    {{ form_widget(form.locale) }}
                    {{ safe_hook('folder.update-form', { folder: folder.id }) }}
                    {{ component('BoSaveModeToolbar', edit_toolbar|merge({ testid: 'folder-edit' })) }}
                    <p class="small text-muted mt-3 mb-0" data-testid="folder-edit-dates">{{ edit_dates }}</p>
                {{ form_widget(form._token) }}
                {# module fields added through the legacy form bridge are rendered by the module hooks, not auto-dumped #}
                {{ form_end(form, {render_rest: false}) }}
                {% if publication|default(null) %}
                    {% include '@BackOfficeDefaultTwig/fragments/publication-form.html.twig' with { publication: publication } only %}
                {% endif %}
            </div>

            <div class="tab-pane fade {% if current_tab == 'children' %}show active{% endif %}" id="tab-children" role="tabpanel">
                <a href="{{ path('admin.folders.default', { folder_id: folder.id }) }}" class="btn btn-outline-primary mb-3">
                    <i class="bi bi-list" aria-hidden="true"></i> {{ 'Manage subfolders'|trans }}
                </a>
                {% set children_rows = [] %}
                {% for child in children %}
                    {% set children_rows = children_rows|merge([{
                        'id': child.id,
                        'title_html': '<a href="' ~ child.edit_url ~ '">' ~ child.title|e ~ '</a>',
                        'visible_html': child.visible ? '<i class="bi bi-check-circle text-success"></i>' : '<i class="bi bi-x-circle text-muted"></i>',
                        'position': child.position,
                        '_actions': [ row_action('edit', 'Edit'|trans, child.edit_url) ],
                    }]) %}
                {% endfor %}
                {{ component('BoDataTable', {
                    id: 'folder-children-table',
                    columns: [
                        column_html('title_html', 'Title'|trans),
                        column_html('visible_html', 'Online'|trans, 'center'),
                        column('position', 'Position'|trans, 'center', hideBelow: 'lg'),
                        column_actions(),
                    ],
                    rows: children_rows,
                    emptyMessage: 'No subfolder.'|trans,
                }) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'images' %}show active{% endif %}" id="tab-images" role="tabpanel">
                {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\File\\FileController::imageForm', { parentType: 'folder', parentId: folder.id })) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'documents' %}show active{% endif %}" id="tab-documents" role="tabpanel">
                {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\File\\FileController::documentForm', { parentType: 'folder', parentId: folder.id })) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'seo' %}show active{% endif %}" id="tab-seo" role="tabpanel">
                {{ safe_hook('tab-seo.top', { id: folder.id, type: 'folder' }) }}
                {% form_theme seo_form with bo_form_themes only %}
                {{ form_start(seo_form, { action: path('admin.folders.seo.save'), method: 'post', attr: { 'data-testid': 'folder-seo-form' } }) }}
                    <div class="mb-3">
                        {{ form_label(seo_form.url) }}
                        {{ form_widget(seo_form.url, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(seo_form.meta_title) }}
                        {{ form_widget(seo_form.meta_title, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(seo_form.meta_description) }}
                        {{ form_widget(seo_form.meta_description, { attr: { class: 'form-control', rows: 3 } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(seo_form.meta_keywords) }}
                        {{ form_widget(seo_form.meta_keywords, { attr: { class: 'form-control', rows: 2 } }) }}
                    </div>
                    {{ form_widget(seo_form.id) }}
                    {{ form_widget(seo_form.locale) }}
                    <button type="submit" class="btn btn-primary" data-testid="folder-seo-submit">
                        <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                    </button>
                {{ form_widget(seo_form._token) }}
                {# module fields added through the legacy form bridge are rendered by the module hooks, not auto-dumped #}
                {{ form_end(seo_form, {render_rest: false}) }}
                {{ hook_cards(['folder.seo.update-form', 'tab-seo.update-form', 'tab-seo.bottom'], { folder_id: folder.id, id: folder.id, type: 'folder' }) }}
            </div>

            {% for block in extra_tabs %}
                <div class="tab-pane fade {% if current_tab == block.id %}show active{% endif %}" id="{{ block.id }}" role="tabpanel">
                    {% if block.href is defined and block.href %}
                        <div class="text-center"><span class="loading">{{ 'Please wait, loading'|trans }}</span></div>
                    {% else %}
                        {{ block.content|raw }}
                    {% endif %}
                </div>
            {% endfor %}

            <div class="tab-pane fade {% if current_tab == 'modules' %}show active{% endif %}" id="tab-modules" role="tabpanel">
                {{ hook_cards('folder.tab-content', { folder: folder.id, folder_id: folder.id, location: 'folder-edit', view: 'folder' }) }}
            </div>
        </div>
    </div>

    {{ safe_hook('folder-edit.bottom', { folder_id: folder.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('folder.edit-js', { folder_id: folder.id, location: 'folder-edit-js' }) }}
    {{ safe_hook('wysiwyg.js', { location: 'folder-edit-js' }) }}
{% endblock %}
