{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Export'|trans }}{% endblock %}
{% block body_testid %}export-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Export'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="export-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Available exports'|trans }}</h1>
            {% if scheduled_reports_available() %}
                <a class="btn btn-outline-secondary" href="{{ path('admin.scheduled-report.default') }}" data-testid="export-scheduled-reports-link">
                    <i class="bi bi-envelope-paper" aria-hidden="true"></i> {{ 'Scheduled reports'|trans }}
                </a>
            {% endif %}
        </div>

        {{ safe_hook('exports.top', { location: 'exports_top' }) }}

        {% if categories is empty %}
            <p class="text-muted">{{ 'No export defined.'|trans }}</p>
        {% else %}
            <div class="row g-4">
                {% for category in categories %}
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">{{ category.title }}</div>
                            {{ safe_hook('exports.row', { category: category.id|default(null) }) }}

                            {% set rows = [] %}
                            {% for export in category.exports %}
                                {% set unavailable_html = export.handler_available ? '' : '<br><span class="badge text-bg-warning" data-testid="export-handler-missing">' ~ 'Unavailable: the module providing this export has been removed'|trans|e ~ '</span>' %}
                                {% set rows = rows|merge([{
                                    'id': export.id,
                                    'title_html': '<div class="text-wrap"><strong>' ~ export.id ~ ' - ' ~ export.title|e ~ '</strong>' ~ (export.description ? '<br><small class="text-muted">' ~ export.description|e ~ '</small>' : '') ~ unavailable_html ~ '</div>',
                                    '_actions': [ row_action('download', 'Export'|trans, path('export.view', { id: export.id })) ],
                                }]) %}
                            {% endfor %}

                            {{ component('BoDataTable', {
                                id: 'exports-' ~ category.id,
                                columns: [
                                    column_html('title_html', 'Export'|trans),
                                    column_actions('_actions', 'Actions'|trans),
                                ],
                                rows: rows,
                                emptyMessage: 'No export in this category.'|trans,
                                tbodyAttributes: {
                                    'data-controller': 'bo-sortable',
                                    'data-bo-sortable-url-value': position_url,
                                    'data-bo-sortable-token-value': assignToken(),
                                    'data-bo-sortable-param-name-value': 'export_id',
                                },
                            }) }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {{ safe_hook('exports.bottom', { location: 'exports_bottom' }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('exports.js', { location: 'exports-js' }) }}
{% endblock %}
