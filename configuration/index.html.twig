{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Configuration'|trans }}{% endblock %}
{% block body_testid %}configuration-index{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Configuration'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% set sections = [
    {
        title: 'Product catalog'|trans,
        hookTop: 'configuration.catalog-top',
        hookBottom: 'configuration.catalog-bottom',
        items: [
            { route: 'admin.configuration.templates.default', label: 'Product templates'|trans, icon: 'bi-collection', resource: 'admin.configuration.template' },
            { route: 'admin.configuration.attributes.default', label: 'Product attributes'|trans, icon: 'bi-tags', resource: 'admin.configuration.attribute' },
            { route: 'admin.configuration.features.default', label: 'Product features'|trans, icon: 'bi-list-stars', resource: 'admin.configuration.feature' },
            { route: 'admin.product-association-type.default', label: 'Product relation types'|trans, icon: 'bi-diagram-3', resource: 'admin.configuration' },
            { route: 'admin.configuration.messages.default', label: 'Mailing templates'|trans, icon: 'bi-envelope-paper', resource: 'admin.configuration.message' },
            { route: 'admin.configuration.currencies.default', label: 'Currencies'|trans, icon: 'bi-currency-exchange', resource: 'admin.configuration.currency' },
            { route: 'admin.configuration.taxes-rules.list', label: 'Tax rules'|trans, icon: 'bi-receipt', resource: 'admin.configuration.tax-rule' },
        ],
    },
    {
        title: 'Shipping'|trans,
        hookTop: 'configuration.shipping-top',
        hookBottom: 'configuration.shipping-bottom',
        items: [
            { route: 'admin.configuration.countries.default', label: 'Countries'|trans, icon: 'bi-globe2', resource: 'admin.configuration.country' },
            { route: 'admin.configuration.states.default', label: 'States / Provinces'|trans, icon: 'bi-pin-map', resource: 'admin.configuration.state' },
            { route: 'admin.configuration.shipping-zones.default', label: 'Shipping configuration'|trans, icon: 'bi-truck', resource: 'admin.configuration.shipping-zone' },
            { route: 'admin.configuration.shipping-configuration.default', label: 'Shipping zones management'|trans, icon: 'bi-map', resource: 'admin.configuration.shipping-configuration' },
            { route: 'admin.delivery-date.list', label: 'Delivery dates'|trans, icon: 'bi-calendar-week', resource: 'admin.configuration.delivery-date' },
        ],
    },
    {
        title: 'Order path'|trans,
        hookTop: 'configuration.order-path.top',
        hookBottom: 'configuration.order-path.bottom',
        items: [
            { route: 'admin.order-status.default', label: 'Order status'|trans, icon: 'bi-list-check', resource: 'admin.configuration.order-status' },
            { route: 'admin.checkout-step.list', label: 'Checkout steps'|trans, icon: 'bi-signpost-split', resource: 'admin.configuration.checkout-step' },
            { route: 'admin.consent.default', label: 'Checkout consents'|trans, icon: 'bi-check2-square', resource: 'admin.configuration.consent' },
            { route: 'admin.gift-wrapping.default', label: 'Gift wrappings'|trans, icon: 'bi-gift', resource: 'admin.configuration.gift-wrapping' },
            { route: 'admin.order-return-reason.default', label: 'Return reasons'|trans, icon: 'bi-arrow-return-left', resource: 'admin.configuration.order-return-reason', enabled: thelia_config('order_return_enabled', '0') == '1' },
        ],
    },
    {
        title: 'Customers'|trans,
        hookTop: 'configuration.customers.top',
        hookBottom: 'configuration.customers.bottom',
        items: [
            { route: 'admin.configuration.tags.default', label: 'Customer tags'|trans, icon: 'bi-tag', resource: 'admin.configuration.tag' },
        ],
    },
    {
        title: 'System'|trans,
        hookTop: 'configuration.system-top',
        hookBottom: 'configuration.system-bottom',
        items: [
            { route: 'admin.configuration.store.default', label: 'Store info'|trans, icon: 'bi-shop', resource: 'admin.configuration.store' },
            { route: 'admin.configuration.variables.default', label: 'System variables'|trans, icon: 'bi-sliders', resource: 'admin.configuration.variable' },
            { route: 'admin.configuration.profiles.list', label: 'Administration profiles'|trans, icon: 'bi-shield-lock', resource: 'admin.configuration.profile' },
            { route: 'admin.configuration.administrators.view', label: 'Administrators'|trans, icon: 'bi-people', resource: 'admin.configuration.administrator' },
            { route: 'admin.configuration.languages.default', label: 'Languages and URLs'|trans, icon: 'bi-translate', resource: 'admin.configuration.language' },
            { route: 'admin.configuration.translations', label: 'Translations'|trans, icon: 'bi-globe', resource: 'admin.configuration.translations' },
            { route: 'admin.configuration.translations-customers-title', label: 'Customer title translations'|trans, icon: 'bi-person-badge', resource: 'admin.configuration.translations' },
            { route: 'admin.mailingSystem.default', label: 'Mailing system'|trans, icon: 'bi-send', resource: 'admin.configuration.mailing-system' },
            { route: 'admin.configuration.admin-logs.view', label: 'Administration logs'|trans, icon: 'bi-clipboard-data', resource: 'admin.configuration.admin-logs' },
            { route: 'admin.configuration.system-logs.default', label: 'System logs'|trans, icon: 'bi-bug', resource: 'admin.configuration.system-logs' },
            { route: 'admin.configuration.advanced', label: 'Advanced configuration'|trans, icon: 'bi-tools', resource: 'admin.configuration.advanced' },
            { route: 'admin.configuration.system-information', label: 'System information'|trans, icon: 'bi-info-circle', resource: 'admin.configuration.advanced' },
            { route: 'admin.hook', label: 'Hooks'|trans, icon: 'bi-plug', resource: 'admin.hook' },
            { route: 'admin.module-hook', label: 'Modules attachments'|trans, icon: 'bi-puzzle', resource: 'admin.module-hook' },
        ],
    },
] %}

{% block content %}
    {{ safe_hook('configuration.top') }}

    <div class="container-fluid" data-testid="configuration-page">
        <h1 class="h3 mb-4">{{ 'Configuration'|trans }}</h1>

        {% for section in sections %}
            {% set visible_items = section.items|filter((item) => (item.enabled is defined ? item.enabled : true) and is_granted('VIEW', item.resource)) %}
            {% if visible_items|length > 0 or section.hookTop is defined %}
                <h2 class="h5 text-muted mb-3">{{ section.title }}</h2>
                <div class="row g-3 mb-4" data-testid="configuration-section">
                    {% if section.hookTop is defined %}{{ safe_hook(section.hookTop) }}{% endif %}
                    {% for item in visible_items %}
                        <div class="col-md-3">
                            <a href="{{ path(item.route) }}" class="card text-decoration-none h-100" data-testid="configuration-link-{{ item.route }}">
                                <div class="card-body d-flex align-items-center gap-3">
                                    <i class="bi {{ item.icon }} fs-3 text-primary" aria-hidden="true"></i>
                                    <span class="fw-medium text-body">{{ item.label }}</span>
                                </div>
                            </a>
                        </div>
                    {% endfor %}
                </div>
                {% if section.hookBottom is defined %}{{ safe_hook(section.hookBottom) }}{% endif %}
            {% endif %}
        {% endfor %}
    </div>

    {{ safe_hook('configuration.bottom') }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('configuration.js', { location: 'configuration-js' }) }}
{% endblock %}
