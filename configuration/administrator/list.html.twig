{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Administrators'|trans }}{% endblock %}
{% block body_testid %}configuration-administrators{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Administrators'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('administrators.top') }}

    <div class="container-fluid" data-testid="administrators-page">
        {% if show_email_change_notice|default(false) %}
            <div class="alert alert-warning"
                 data-controller="bo-auto-open-modal"
                 data-bo-auto-open-modal-target-value="#administrator-edit-modal-{{ current_admin_id }}"
                 data-testid="administrator-email-notice">
                {{ 'Please set an email address for your account to continue.'|trans }}
            </div>
        {% elseif edit_forms[app.request.query.getInt('edit')] is defined %}
            {# Opened from the global search: the administrator found is shown in their edit dialog. #}
            <div hidden
                 data-controller="bo-auto-open-modal"
                 data-bo-auto-open-modal-target-value="#administrator-edit-modal-{{ app.request.query.getInt('edit') }}"
                 data-testid="administrator-edit-requested"></div>
        {% endif %}

        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Administrators management'|trans }}</h1>
            {% if is_granted('CREATE', 'admin.configuration.administrator') %}
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#administrator-create-modal" data-testid="administrator-create-button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    {{ 'Add a new administrator'|trans }}
                </button>
            {% endif %}
        </div>

        {{ component('BoDataTable', {
            id: 'administrators',
            columns: [
                column('id', 'ID'|trans, 'start', 'id', hideBelow: 'md'),
                column('login', 'Login'|trans, 'start', 'login'),
                column('name', 'Name'|trans, 'start', 'lastname'),
                column('email', 'Email'|trans, 'start', 'email', hideBelow: 'lg'),
                column('profile', 'Profile'|trans, hideBelow: 'lg'),
                column('two_factor', 'Two-step verification'|trans, hideBelow: 'md'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No administrator yet.'|trans,
            extraColumnsHeaderHook: 'administrators.header',
            extraColumnsHook: 'administrators.row',
            headerHookContext: { location: 'administrator_list_header' },
            rowHookContext: { location: 'administrator_list_row' },
            rowHookArgs: { admin_id: 'id' },
            sortField: sort_field,
            sortDirection: sort_direction,
        }) }}
    </div>

    {{ safe_hook('administrators.bottom') }}

    {% component 'BoCreateDialog' with {
        id: 'administrator-create-modal',
        title: 'Create a new administrator',
        form: create_form,
        formAction: path('admin.configuration.administrators.add'),
        submitLabel: 'Create this administrator',
        testid: 'administrator-create',
        hook: 'administrator.create-form',
    } %}
        {% block fields %}
            {{ form_widget(create_form.locale) }}
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(create_form.login) }}</div>
                <div class="col-md-6">{{ form_row(create_form.email) }}</div>
                <div class="col-md-6">{{ form_row(create_form.firstname) }}</div>
                <div class="col-md-6">{{ form_row(create_form.lastname) }}</div>
                <div class="col-md-6">{{ form_row(create_form.password) }}</div>
                <div class="col-md-6">{{ form_row(create_form.profile) }}</div>
                {% if create_form.sale_units is defined %}
                    <div class="col-12">{% include '@BackOfficeDefaultTwig/configuration/administrator/_sale_units.html.twig' with { field: create_form.sale_units, testid: 'administrator-create-sale-units' } only %}</div>
                {% endif %}
            </div>
        {% endblock %}
    {% endcomponent %}

    {% for admin_id, edit_form in edit_forms %}
        {% component 'BoCreateDialog' with {
            id: 'administrator-edit-modal-' ~ admin_id,
            title: 'Edit administrator',
            form: edit_form,
            formAction: path('admin.configuration.administrators.save'),
            submitLabel: 'Save changes',
            testid: 'administrator-edit-' ~ admin_id,
            hook: 'administrator.edit-form',
            hookContext: { administrator_id: admin_id },
        } %}
            {% block fields %}
                {{ form_widget(edit_form.id) }}
                {{ form_widget(edit_form.locale) }}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(edit_form.login) }}</div>
                    <div class="col-md-6">{{ form_row(edit_form.email) }}</div>
                    <div class="col-md-6">{{ form_row(edit_form.firstname) }}</div>
                    <div class="col-md-6">{{ form_row(edit_form.lastname) }}</div>
                    <div class="col-md-6">{{ form_row(edit_form.password) }}</div>
                    <div class="col-md-6">{{ form_row(edit_form.profile) }}</div>
                    {% if edit_form.sale_units is defined %}
                        <div class="col-12">{% include '@BackOfficeDefaultTwig/configuration/administrator/_sale_units.html.twig' with { field: edit_form.sale_units, testid: 'administrator-sale-units-' ~ admin_id } only %}</div>
                    {% endif %}
                </div>
            {% endblock %}
        {% endcomponent %}
    {% endfor %}

    {{ component('BoConfirmDialog', {
        id: 'administrator-two-factor-reset-modal',
        title: 'Reset the two-step verification',
        formAction: path('admin.configuration.administrators.two-factor-reset'),
        message: 'This administrator will sign in with their password alone, then enable two-step verification again. Do this only once you are sure of who asks for it.',
        variant: 'warning',
        confirmLabel: 'Reset the two-step verification',
        confirmIcon: 'bi-shield-x',
        testid: 'administrator-two-factor-reset',
        prefillTrigger: 'data-administrator-id',
        prefillInput: 'administrator_id',
    }) }}

    {{ component('BoConfirmDialog', {
        id: 'administrator-delete-modal',
        title: 'Delete administrator',
        formAction: path('admin.configuration.administrators.delete'),
        message: 'Do you really want to delete this administrator?',
        testid: 'administrator-delete',
        hook: 'administrator.delete-form',
        prefillTrigger: 'data-administrator-id',
        prefillInput: 'administrator_id',
    }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('administrators.js', { location: 'administrators-js' }) }}
{% endblock %}
