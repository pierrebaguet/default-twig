{# The seven days of the week as checkboxes, ticked when closed. #}
<fieldset class="mb-3" {% if disabled|default(false) %}disabled{% endif %} data-testid="{{ testid }}">
    <legend class="form-label fs-6">{{ legend }}</legend>
    <div class="d-flex flex-wrap gap-3">
        {% for number, name in weekdays %}
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="closed_weekdays[]" value="{{ number }}" id="{{ testid }}-{{ number }}" {% if number in closed %}checked{% endif %}>
                <label class="form-check-label" for="{{ testid }}-{{ number }}">{{ name }}</label>
            </div>
        {% endfor %}
    </div>
</fieldset>
