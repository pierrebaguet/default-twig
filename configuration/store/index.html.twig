{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Store configuration'|trans }}{% endblock %}
{% block body_testid %}configuration-store{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Store'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('configuration.store.top') }}

    <div class="container-fluid" data-testid="config-store-page">
        <h1 class="h3 mb-4">{{ 'Store configuration'|trans }}</h1>

        {% form_theme form with bo_form_themes only %}
        {{ form_start(form, {
            action: path('admin.configuration.store.save'),
            method: 'post',
            attr: { 'data-testid': 'config-store-form', enctype: 'multipart/form-data' },
        }) }}

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card mb-4">
                        <div class="card-header">{{ 'General'|trans }}</div>
                        <div class="card-body">
                            {{ form_row(form.store_name) }}
                            {{ form_row(form.store_description) }}
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">{{ 'Company identifiers'|trans }}</div>
                        <div class="card-body">
                            {{ form_row(form.store_siret) }}
                            {{ form_row(form.store_vat_intracom) }}
                            {{ form_row(form.store_ape_code) }}
                            {{ form_row(form.store_eori) }}

                            <div class="form-check mb-2">
                                {{ form_widget(form.store_vat_exempt, { attr: { class: 'form-check-input' } }) }}
                                {{ form_label(form.store_vat_exempt, null, { label_attr: { class: 'form-check-label' } }) }}
                                {{ form_help(form.store_vat_exempt) }}
                            </div>
                            <div class="form-check mb-3">
                                {{ form_widget(form.store_registration_exempt, { attr: { class: 'form-check-input' } }) }}
                                {{ form_label(form.store_registration_exempt, null, { label_attr: { class: 'form-check-label' } }) }}
                                {{ form_help(form.store_registration_exempt) }}
                            </div>

                            {{ form_row(form.store_legal_mentions) }}
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">{{ 'Email addresses'|trans }}</div>
                        <div class="card-body">
                            {{ form_row(form.store_email) }}
                            {{ form_row(form.store_notification_emails) }}
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">{{ 'Media'|trans }}</div>
                        <div class="card-body">
                            <div class="row g-3 align-items-end" data-controller="bo-image-preview">
                                <div class="col-sm-9">{{ form_row(form.favicon_file, { attr: { 'data-bo-image-preview-target': 'input' } }) }}</div>
                                <div class="col-sm-3 text-end">
                                    <img src="{{ media_urls.favicon|default('') }}"
                                         alt="{{ 'Favicon preview'|trans }}"
                                         class="img-thumbnail"
                                         width="64"
                                         height="64"
                                         style="object-fit: contain; {% if media_urls.favicon is null %}display:none;{% endif %}"
                                         data-bo-image-preview-target="image"
                                         data-testid="config-store-favicon-preview">
                                </div>
                            </div>
                            <div class="row g-3 align-items-end mt-2" data-controller="bo-image-preview">
                                <div class="col-sm-9">{{ form_row(form.logo_file, { attr: { 'data-bo-image-preview-target': 'input' } }) }}</div>
                                <div class="col-sm-3 text-end">
                                    <img src="{{ media_urls.logo|default('') }}"
                                         alt="{{ 'Logo preview'|trans }}"
                                         class="img-thumbnail"
                                         style="max-width: 100%; max-height: 80px; {% if media_urls.logo is null %}display:none;{% endif %}"
                                         data-bo-image-preview-target="image"
                                         data-testid="config-store-logo-preview">
                                </div>
                            </div>
                            <div class="row g-3 mt-2" data-controller="bo-image-preview">
                                <div class="col-12">{{ form_row(form.banner_file, { attr: { 'data-bo-image-preview-target': 'input' } }) }}</div>
                                <div class="col-12 text-center">
                                    <img src="{{ media_urls.banner|default('') }}"
                                         alt="{{ 'Banner preview'|trans }}"
                                         class="img-thumbnail"
                                         style="max-width: 100%; max-height: 160px; {% if media_urls.banner is null %}display:none;{% endif %}"
                                         data-bo-image-preview-target="image"
                                         data-testid="config-store-banner-preview">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card mb-4">
                        <div class="card-header">{{ 'Store address'|trans }}</div>
                        <div class="card-body">
                            {{ form_row(form.store_address1) }}
                            {{ form_row(form.store_address2) }}
                            {{ form_row(form.store_address3) }}

                            <div class="row g-2">
                                <div class="col-md-4">{{ form_row(form.store_zipcode) }}</div>
                                <div class="col-md-8">{{ form_row(form.store_city) }}</div>
                            </div>

                            {{ form_row(form.store_country) }}
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">{{ 'Phone & Fax'|trans }}</div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-md-6">{{ form_row(form.store_phone) }}</div>
                                <div class="col-md-6">{{ form_row(form.store_fax) }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">{{ 'Checkout'|trans }}</div>
                        <div class="card-body">
                            {{ form_row(form.guest_checkout_mode, { attr: { 'data-testid': 'config-store-guest-checkout-mode' } }) }}
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">{{ 'Administrators'|trans }}</div>
                        <div class="card-body">
                            {{ form_row(form.admin_two_factor_required, { attr: { 'data-testid': 'config-store-admin-two-factor-required' } }) }}
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">{{ 'Product videos'|trans }}</div>
                        <div class="card-body">
                            {{ form_row(form.video_providers, { attr: { 'data-testid': 'config-store-video-providers' } }) }}
                        </div>
                    </div>
                </div>
            </div>

            {{ component('BoSaveModeToolbar', {
                closeUrl: path('admin.configuration.index'),
                closeLabel: 'Cancel',
                testid: 'config-store',
            }) }}
        {{ form_end(form) }}
    </div>

    {{ safe_hook('configuration.store.bottom') }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('config-store.js', { location: 'config-store-js' }) }}
{% endblock %}
