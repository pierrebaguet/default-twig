{#
    Figures of the customer sheet. `overview.kpis` is null when the administrator may not
    see the orders: the order figures are then left out, only the account age remains.
#}
{% macro tile(label, value, icon, accent, testid, hint = null, note = null) %}
    <div class="col-6 col-md-4 col-xxl-2">
        <div class="card h-100 shadow-sm border-0" data-testid="{{ testid }}">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 text-muted small">
                    <span class="rounded-circle bg-{{ accent }}-subtle text-{{ accent }} d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:28px;height:28px;">
                        <i class="bi {{ icon }}" aria-hidden="true"></i>
                    </span>
                    <span>{{ label }}</span>
                    {% if hint %}
                        <i class="bi bi-info-circle ms-auto" tabindex="0" role="img" data-bs-toggle="tooltip" title="{{ hint }}" aria-label="{{ hint }}" data-testid="{{ testid }}-hint"></i>
                    {% endif %}
                </div>
                <div class="h5 mb-0 fw-semibold mt-2" data-testid="{{ testid }}-value">{{ value }}</div>
                {% if note %}<div class="small text-muted mt-1" data-testid="{{ testid }}-note">{{ note }}</div>{% endif %}
            </div>
        </div>
    </div>
{% endmacro %}

{% set kpis = overview.kpis %}
{% set definition = 'Counted on the paid, processing and sent orders, like the dashboard revenue. Cancelled, refunded and unpaid orders are left out.'|trans %}

<div class="row g-3 mb-3" data-testid="customer-kpis">
    {% if kpis is not null %}
        {% set money = kpis.currencySymbol %}
        {{ _self.tile(
            'Total spent'|trans,
            kpis.totalSpent|number_format(2, '.', ' ') ~ ' ' ~ money,
            'bi-cash-stack', 'success', 'customer-kpi-total-spent',
            definition,
            kpis.mixesCurrencies ? 'Amounts in several currencies, added up unconverted'|trans : null
        ) }}
        {{ _self.tile(
            'Orders'|trans,
            kpis.orderCount,
            'bi-bag-check', 'primary', 'customer-kpi-order-count',
            definition,
            kpis.excludedOrderCount > 0 ? '%count% more left out'|trans({ '%count%': kpis.excludedOrderCount }) : null
        ) }}
        {{ _self.tile(
            'Average basket'|trans,
            kpis.averageBasket is not null ? kpis.averageBasket|number_format(2, '.', ' ') ~ ' ' ~ money : '-',
            'bi-basket', 'info', 'customer-kpi-average-basket',
            'Total spent divided by the number of orders counted.'|trans
        ) }}
        {{ _self.tile(
            'First order'|trans,
            kpis.firstOrderAt ? kpis.firstOrderAt|format_date('medium') : 'Never'|trans,
            'bi-calendar-check', 'secondary', 'customer-kpi-first-order'
        ) }}
        {{ _self.tile(
            'Last order'|trans,
            kpis.lastOrderAt ? kpis.lastOrderAt|format_date('medium') : 'Never'|trans,
            'bi-calendar-event', 'secondary', 'customer-kpi-last-order'
        ) }}
    {% endif %}
    {{ _self.tile(
        'Customer since'|trans,
        overview.customerAge ?: '-',
        'bi-hourglass-split', 'warning', 'customer-kpi-customer-since',
        null,
        overview.customerSince ? overview.customerSince|format_date('medium') : null
    ) }}
</div>
