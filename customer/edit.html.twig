{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit customer'|trans }}{% endblock %}
{% block body_testid %}customer-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.customers') }}">{{ 'Customers'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ customer.firstname }} {{ customer.lastname }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('customer-edit.top', { customer_id: customer.id }) }}

    <div class="container-fluid" data-testid="customer-edit-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0" data-testid="customer-edit-title">
                {{ 'Edit customer'|trans }}: <span class="text-muted">{{ customer.firstname }} {{ customer.lastname }}</span>
                <small class="text-secondary ms-2">{{ customer.ref }}</small>
                {% if customer.isGuest %}
                    <span class="badge text-bg-warning-subtle text-warning-emphasis ms-2" data-testid="customer-edit-guest-badge">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i> {{ 'Ordered without creating an account'|trans }}
                    </span>
                {% endif %}
            </h1>
            {% include '@BackOfficeDefaultTwig/_prev_next_buttons.html.twig' with {
                prev_url: prev_url|default(null),
                next_url: next_url|default(null),
                prev_label: 'Edit previous customer'|trans,
                next_label: 'Edit next customer'|trans,
                testid: 'customer',
            } only %}
        </div>

        {% include '@BackOfficeDefaultTwig/customer/_kpi_band.html.twig' with { overview: overview } only %}

        {% form_theme form with bo_form_themes only %}
        {{ form_start(form, {
            action: path('admin.customer.update.process'),
            method: 'post',
            attr: { 'data-testid': 'customer-edit-form' },
        }) }}
            <input type="hidden" name="customer_id" value="{{ customer.id }}">
            {% if form.id is defined %}{{ form_widget(form.id) }}{% endif %}

            <div class="row g-3">
                {# Left column — identity, account, address, contact #}
                <div class="col-xl-8">
                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-person" aria-hidden="true"></i> {{ 'Personal information'|trans }}
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-2">{{ form_row(form.title) }}</div>
                                <div class="col-md-5">{{ form_row(form.firstname) }}</div>
                                <div class="col-md-5">{{ form_row(form.lastname) }}</div>
                                <div class="col-12">{{ form_row(form.email) }}</div>
                            </div>
                        </div>
                    </div>

                    {% if form.password is defined %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <i class="bi bi-key" aria-hidden="true"></i> {{ 'Reset password'|trans }}
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">{{ form_row(form.password) }}</div>
                                    <div class="col-md-6">{{ form_row(form.password_confirm) }}</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-geo-alt" aria-hidden="true"></i> {{ 'Default address'|trans }}
                        </div>
                        <div class="card-body">
                            {% if form.address1 is defined %}
                                <div class="row g-3">
                                    <div class="col-12">{{ form_row(form.address1) }}</div>
                                    <div class="col-md-6">{{ form_row(form.address2) }}</div>
                                    <div class="col-md-6">{{ form_row(form.address3) }}</div>
                                    <div class="col-md-6">{{ form_row(form.zipcode) }}</div>
                                    <div class="col-md-6">{{ form_row(form.city) }}</div>
                                    <div class="col-12" data-controller="bo-state-cascade">
                                        <div class="row g-3">
                                            <div class="col-md-6">{{ form_row(form.country) }}</div>
                                            <div class="col-md-6" data-bo-state-cascade-target="wrapper">{{ form_row(form.state) }}</div>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="alert alert-info mb-0 d-flex align-items-center gap-2" data-testid="customer-no-address-notice">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                    <span>{{ 'This customer has no address yet. Use the Addresses section below to add one.'|trans }}</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {% if form.phone is defined %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <i class="bi bi-telephone" aria-hidden="true"></i> {{ 'Contact'|trans }}
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">{{ form_row(form.phone) }}</div>
                                    <div class="col-md-6">{{ form_row(form.cellphone) }}</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# Right column — business + preferences + meta #}
                <div class="col-xl-4">
                    {% if form.company is defined %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <i class="bi bi-building" aria-hidden="true"></i> {{ 'Business'|trans }}
                            </div>
                            <div class="card-body">
                                {{ form_row(form.company) }}
                                {% if form.siret is defined %}{{ form_row(form.siret) }}{% endif %}
                                {% if form.vat_number is defined %}{{ form_row(form.vat_number) }}{% endif %}
                                {# A warning and not a block: an address saved before these columns
                                   existed is legitimate, and only a submit has to be complete. #}
                                {% set companyGiven = form.company.vars.value|default('')|trim is not empty %}
                                {% if companyGiven and form.siret is defined and form.vat_number is defined
                                    and (form.siret.vars.value|default('')|trim is empty
                                         or form.vat_number.vars.value|default('')|trim is empty) %}
                                    <div class="alert alert-warning mb-0 mt-3" data-testid="customer-legal-identifiers-incomplete">
                                        {{ 'This customer has a company name but is missing a registration number or a VAT number. An invoice for a business buyer requires both.'|trans }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                    {% if form.tags is defined %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <i class="bi bi-tags" aria-hidden="true"></i> {{ 'Tags'|trans }}
                            </div>
                            <div class="card-body"
                                 data-controller="bo-multiselect-search bo-tag-picker"
                                 data-bo-tag-picker-create-label-value="{{ 'Create “%label%”'|trans }}"
                                 data-bo-tag-picker-empty-label-value="{{ 'No matching tag.'|trans }}"
                                 data-bo-tag-picker-remove-label-value="{{ 'Remove %label%'|trans }}">
                                {# The chip input below is an enhancement over these two fields, not a
                                   replacement: they stay in the form and carry the submission. Without
                                   JavaScript they are what the operator sees, and the search box hides
                                   the non-matching options client-side the way the coupon and sale
                                   audiences do. #}
                                <div data-bo-tag-picker-target="fallback">
                                    <input type="search"
                                           class="form-control mb-2"
                                           placeholder="{{ 'Filter the tags…'|trans }}"
                                           aria-label="{{ 'Filter the tags…'|trans }}"
                                           data-bo-multiselect-search-target="input"
                                           data-action="input->bo-multiselect-search#filter"
                                           data-testid="customer-tags-filter">
                                    {{ form_row(form.tags) }}
                                    {{ form_row(form.new_tags) }}
                                </div>

                                <div class="d-none" data-bo-tag-picker-target="widget" data-testid="customer-tags-picker">
                                    {# No visible label: the card header already says "Tags", and a
                                       second one under it reads as a different field. #}
                                    <div class="bo-tag-picker__control"
                                         data-action="click->bo-tag-picker#focusInput">
                                        <span class="bo-tag-picker__chips" data-bo-tag-picker-target="chips"></span>
                                        <input type="text"
                                               id="customer-tags-picker-input"
                                               class="bo-tag-picker__input"
                                               autocomplete="off"
                                               role="combobox"
                                               aria-autocomplete="list"
                                               aria-controls="customer-tags-picker-menu"
                                               aria-label="{{ 'Tags'|trans }}"
                                               placeholder="{{ 'Search or create a tag…'|trans }}"
                                               data-bo-tag-picker-target="input"
                                               data-action="input->bo-tag-picker#search focus->bo-tag-picker#open blur->bo-tag-picker#close keydown->bo-tag-picker#key">
                                    </div>
                                    <ul class="bo-tag-picker__menu d-none"
                                        id="customer-tags-picker-menu"
                                        role="listbox"
                                        data-bo-tag-picker-target="menu"></ul>
                                </div>

                                <span class="form-text small">{{ 'A tag the shop does not know yet is created when the customer is saved.'|trans }}</span>
                            </div>
                        </div>
                    {% endif %}

                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-sliders" aria-hidden="true"></i> {{ 'Preferences'|trans }}
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12">{{ form_row(form.lang_id) }}</div>
                                <div class="col-12">{{ form_row(form.discount) }}</div>
                                <div class="col-12">{{ form_row(form.reseller) }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body small text-muted d-flex align-items-center gap-2">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            {{ 'Registered on %date'|trans({ '%date': customer.createdAt ? customer.createdAt|format_datetime('medium', 'short') : '-' }) }}
                        </div>
                    </div>

                    <div class="card mb-3" data-testid="customer-personal-data-card">
                        <div class="card-header">
                            <i class="bi bi-shield-lock" aria-hidden="true"></i> {{ 'Personal data'|trans }}
                        </div>
                        <div class="card-body">
                            <p class="small text-muted">
                                {{ 'Answer a data subject request without touching the accounting record of the orders.'|trans }}
                            </p>
                            <div class="d-grid gap-2">
                                <a href="{{ path('admin.customer.personal_data.export', { customer_id: customer.id }) }}"
                                   data-bo-post
                                   class="btn btn-sm btn-outline-primary"
                                   data-testid="customer-personal-data-export">
                                    <i class="bi bi-download" aria-hidden="true"></i> {{ 'Download personal data'|trans }}
                                </a>
                                {% if is_granted('DELETE', 'admin.customer') %}
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#customer-anonymize-modal"
                                            data-customer-id="{{ customer.id }}"
                                            data-testid="customer-anonymize-button">
                                        <i class="bi bi-eraser" aria-hidden="true"></i> {{ 'Anonymize this customer'|trans }}
                                    </button>
                                {% endif %}
                            </div>
                            {{ safe_hook('customer.personal-data', { customer_id: customer.id, location: 'customer_personal_data' }) }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-4">
                <a href="{{ path('admin.customers') }}" class="btn btn-outline-secondary" data-testid="customer-edit-cancel">
                    {{ 'Cancel'|trans }}
                </a>
                <button type="submit" class="btn btn-primary" data-testid="customer-edit-submit">
                    <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                </button>
            </div>
        {{ form_end(form) }}

        {{ safe_hook('customer.edit', { customer_id: customer.id }) }}

        {# ── Addresses ──────────────────────────────────────────────────── #}
        {% set addresses_rows = [] %}
        {% for addr in addresses %}
            {% set addr_label_html = addr.label|e ~ (addr.is_default ? ' <span class="badge bg-success ms-1">' ~ 'Default'|trans ~ '</span>' : '') %}
            {% set addr_actions = [
                row_action('edit', 'Edit'|trans, path('admin.address.update.view', { address_id: addr.id })),
            ] %}
            {% if not addr.is_default and is_granted('UPDATE', 'admin.address') %}
                {% set addr_actions = addr_actions|merge([
                    row_action('set-default', 'Set as default'|trans, null, '#address-set-default-modal', null, null, {'data-address-id': addr.id}),
                ]) %}
            {% endif %}
            {% if is_granted('DELETE', 'admin.address') %}
                {% set addr_actions = addr_actions|merge([
                    row_action('delete', 'Delete'|trans, null, '#address-delete-modal', null, null, {'data-address-id': addr.id}),
                ]) %}
            {% endif %}
            {% set addresses_rows = addresses_rows|merge([{
                'id': addr.id,
                'label_html': addr_label_html,
                'name': addr.firstname|e ~ ' ' ~ addr.lastname|e,
                'address': addr.address,
                '_actions': addr_actions,
            }]) %}
        {% endfor %}

        <div class="mt-4" data-testid="customer-addresses-section">
            {{ component('BoDataTable', {
                id: 'customer-addresses',
                caption: 'Addresses'|trans ~ ' (' ~ addresses|length ~ ')',
                columns: [
                    column_html('label_html', 'Label'|trans),
                    column('name', 'Name'|trans),
                    column('address', 'Address'|trans, hideBelow: 'lg'),
                    column_actions(),
                ],
                rows: addresses_rows,
                emptyMessage: 'No address registered for this customer.'|trans,
            }) }}
        </div>

        {% if is_granted('CREATE', 'admin.address') %}
            <div class="d-flex justify-content-end mt-2">
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#customer-address-create-modal" data-testid="customer-address-create-button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a new address'|trans }}
                </button>
            </div>
        {% endif %}

        {# ── Recent orders, left out for an administrator who may not see them ── #}
        {% if overview.canViewOrders %}
        {% set orders_rows = [] %}
        {% for order in recent_orders %}
            {% set orders_rows = orders_rows|merge([{
                'id': order.id,
                'ref_html': '<a href="' ~ order.edit_url|e ~ '" class="link-primary text-decoration-none fw-medium">' ~ order.ref|e ~ '</a>',
                'created_at': order.created_at ? order.created_at|format_datetime('medium', 'short') : '-',
                'status_html': '<span class="badge" style="background-color: ' ~ order.status_color|e ~ ';">' ~ order.status_title|e ~ '</span>',
                'total': order.amount|number_format(2, '.', ' ') ~ ' ' ~ order.currency_symbol,
                '_actions': [
                    row_action('view', 'View'|trans, order.edit_url),
                ],
            }]) %}
        {% endfor %}

        <div class="mt-4" data-testid="customer-orders-section">
            {{ component('BoDataTable', {
                id: 'customer-orders',
                caption: ('Orders for this customer'|trans) ~ ' (' ~ orders_total|default(0) ~ ')',
                columns: [
                    column_html('ref_html', 'Reference'|trans),
                    column('created_at', 'Date'|trans, hideBelow: 'lg'),
                    column_html('status_html', 'Status'|trans),
                    column('total', 'Total'|trans, 'end'),
                    column_actions(),
                ],
                rows: orders_rows,
                emptyMessage: 'This customer has not placed any order yet.'|trans,
                extraColumnsHeaderHook: 'customer.orders-table-header',
                extraColumnsHook: 'customer.orders-table-row',
                headerHookContext: { customer_id: customer.id, location: 'orders_table_header' },
                rowHookContext: { customer_id: customer.id, location: 'orders_table_row' },
                rowHookArgs: { order_id: 'id' },
            }) }}
            {% if orders_last_page|default(1) > 1 %}
                {{ component('BoPagination', {
                    route: 'admin.customer.update.view',
                    currentPage: orders_page,
                    lastPage: orders_last_page,
                    routeParams: { customer_id: customer.id },
                    pageParam: 'orders_page',
                    ariaLabel: 'Customer orders pagination'|trans,
                    testid: 'customer-orders',
                }) }}
            {% endif %}
        </div>
        {% endif %}
    </div>

    {% if address_create_form is defined and is_granted('CREATE', 'admin.address') %}
        {% include '@BackOfficeDefaultTwig/customer/_customer_address_create_modal.html.twig' %}
    {% endif %}

    {{ component('BoConfirmDialog', {
        id: 'address-set-default-modal',
        title: 'Set as default address',
        formAction: path('admin.address.makeItDefault'),
        message: 'Set this address as the default address for this customer?',
        variant: 'primary',
        confirmLabel: 'Set as default',
        confirmIcon: 'bi-star-fill',
        token: true,
        testid: 'address-set-default',
        prefillTrigger: 'data-address-id',
        prefillInput: 'address_id',
    }) }}

    {{ component('BoConfirmDialog', {
        id: 'address-delete-modal',
        title: 'Delete address',
        formAction: path('admin.address.delete'),
        message: 'Delete this address?',
        variant: 'danger',
        token: true,
        testid: 'address-delete',
        hook: 'customer.address-delete-form',
        hookContext: { customer_id: customer.id, location: 'customer_address_delete_form' },
        prefillTrigger: 'data-address-id',
        prefillInput: 'address_id',
    }) }}

    {% if is_granted('DELETE', 'admin.customer') %}
        {{ component('BoConfirmDialog', {
            id: 'customer-anonymize-modal',
            title: 'Anonymize this customer',
            formAction: path('admin.customer.anonymize'),
            message: 'The name, email, password, addresses, carts and newsletter subscription of this customer are erased, the tags they carry are taken off them, and the identity frozen on their orders is neutralised. The orders themselves, their amounts, taxes and invoice numbers are kept. This cannot be undone.',
            confirmLabel: 'Anonymize',
            confirmIcon: 'bi-eraser',
            testid: 'customer-anonymize',
            hook: 'customer.anonymize-form',
            hookContext: { customer_id: customer.id, location: 'customer_anonymize_form' },
            prefillTrigger: 'data-customer-id',
            prefillInput: 'customer_id',
        }) }}
    {% endif %}

    {{ safe_hook('customer-edit.bottom', { customer_id: customer.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('customer.edit-js', { customer_id: customer.id, location: 'customer-edit-js' }) }}
{% endblock %}
