{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Products'|trans }}{% endblock %}
{% block body_testid %}catalog-products{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Products'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('products.top') }}

    <div class="container-fluid" data-testid="products-page" data-controller="bo-bulk-select">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Products management'|trans } %}
            {% block actions %}
                {% if is_granted('CREATE', 'admin.product') %}
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#product-create-modal" data-testid="product-create-button">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a new product'|trans }}
                    </button>
                {% endif %}
            {% endblock %}
        {% endembed %}

        <form method="get" action="{{ path('admin.products.default') }}" class="bo-order-filters" data-testid="product-search-form">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="product-search-q">{{ 'Search'|trans }}</label>
                    <input type="search" id="product-search-q" name="q" value="{{ filters.search_input }}"
                           class="form-control"
                           placeholder="{{ 'Title, reference, GTIN or manufacturer part number'|trans }}"
                           data-testid="product-search-input">
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="product-filter-category">{{ 'Category'|trans }}</label>
                    <select name="category_id" id="product-filter-category" class="form-select" data-testid="product-filter-category">
                        {% for cat in filters.category_options %}
                            <option value="{{ cat.id }}" {{ cat.id == (filters.selected_category_id ?? 0) ? 'selected' : '' }}>{{ cat.title }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" data-testid="product-search-submit">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i>{{ 'Apply'|trans }}
                    </button>
                    <a href="{{ filters.clear_all_url }}" class="btn btn-outline-secondary" data-testid="product-search-clear">{{ 'Reset'|trans }}</a>
                </div>
            </div>

            <div class="mt-3">
                <button type="button" class="btn btn-link p-0 bo-order-filters__toggle" data-bs-toggle="collapse"
                        data-bs-target="#bo-product-advanced" aria-controls="bo-product-advanced"
                        aria-expanded="{{ filters.advanced_count > 0 ? 'true' : 'false' }}"
                        data-testid="product-advanced-toggle">
                    <i class="bi bi-sliders me-1" aria-hidden="true"></i>
                    <span class="bo-order-filters__toggle-label">{{ 'Advanced filters'|trans }}</span>
                    {% if filters.advanced_count > 0 %}
                        <span class="badge bg-primary ms-1">{{ filters.advanced_count }}</span>
                    {% endif %}
                    <i class="bi bi-chevron-down ms-1 bo-order-filters__toggle-caret" aria-hidden="true"></i>
                </button>
            </div>

            <div id="bo-product-advanced" class="bo-order-filters__panel collapse {{ filters.advanced_count > 0 ? 'show' : '' }}"
                 data-testid="product-advanced-panel">
                <div class="row g-2 pt-2">
                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Brand / Supplier'|trans }}</legend>
                            <select name="brand_id" class="form-select form-select-sm" data-testid="product-filter-brand">
                                <option value="">{{ 'All'|trans }}</option>
                                {% for option in filters.brand_options %}
                                    <option value="{{ option.id }}" {{ option.id == filters.selected_brand_id ? 'selected' : '' }}>{{ option.title }}</option>
                                {% endfor %}
                            </select>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Product template'|trans }}</legend>
                            <select name="template_id" class="form-select form-select-sm" data-testid="product-filter-template">
                                <option value="">{{ 'All'|trans }}</option>
                                {% for option in filters.template_options %}
                                    <option value="{{ option.id }}" {{ option.id == filters.selected_template_id ? 'selected' : '' }}>{{ option.title }}</option>
                                {% endfor %}
                            </select>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="row g-2">
                            <div class="col">
                                <fieldset>
                                    <legend class="form-label">{{ 'Online'|trans }}</legend>
                                    <select name="visible" class="form-select form-select-sm" data-testid="product-filter-visible">
                                        {% for option in filters.tristate_options %}
                                            <option value="{{ option.value }}" {{ option.value == filters.visible_value ? 'selected' : '' }}>{{ option.label }}</option>
                                        {% endfor %}
                                    </select>
                                </fieldset>
                            </div>
                            <div class="col">
                                <fieldset>
                                    <legend class="form-label">{{ 'On sale'|trans }}</legend>
                                    <select name="promo" class="form-select form-select-sm" data-testid="product-filter-promo">
                                        {% for option in filters.tristate_options %}
                                            <option value="{{ option.value }}" {{ option.value == filters.promo_value ? 'selected' : '' }}>{{ option.label }}</option>
                                        {% endfor %}
                                    </select>
                                </fieldset>
                            </div>
                            <div class="col">
                                <fieldset>
                                    <legend class="form-label">{{ 'New'|trans }}</legend>
                                    <select name="new" class="form-select form-select-sm" data-testid="product-filter-new">
                                        {% for option in filters.tristate_options %}
                                            <option value="{{ option.value }}" {{ option.value == filters.new_value ? 'selected' : '' }}>{{ option.label }}</option>
                                        {% endfor %}
                                    </select>
                                </fieldset>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Price (excl. tax)'|trans }}</legend>
                            {% include '@BackOfficeDefaultTwig/catalog/product/_range_filter.html.twig' with {
                                slider: filters.price_slider,
                                min_name: 'min_price',
                                max_name: 'max_price',
                                min_value: filters.min_price_input,
                                max_value: filters.max_price_input,
                                unit: '€',
                                testid: 'product-filter-price',
                            } only %}
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Stock'|trans }}</legend>
                            {% include '@BackOfficeDefaultTwig/catalog/product/_range_filter.html.twig' with {
                                slider: filters.quantity_slider,
                                min_name: 'min_quantity',
                                max_name: 'max_quantity',
                                min_value: filters.min_quantity_input,
                                max_value: filters.max_quantity_input,
                                unit: '',
                                testid: 'product-filter-quantity',
                            } only %}
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="row g-2">
                            <div class="col">
                                <fieldset>
                                    <legend class="form-label">{{ 'Features'|trans }}</legend>
                                    <select name="feature_ids[]" class="form-select form-select-sm" multiple size="4" data-testid="product-filter-features">
                                        {% for option in filters.feature_options %}
                                            <option value="{{ option.id }}" {{ option.id in filters.selected_feature_ids ? 'selected' : '' }}>{{ option.title }}</option>
                                        {% endfor %}
                                    </select>
                                </fieldset>
                            </div>
                            <div class="col">
                                <fieldset>
                                    <legend class="form-label">{{ 'Attributes'|trans }}</legend>
                                    <select name="attribute_ids[]" class="form-select form-select-sm" multiple size="4" data-testid="product-filter-attributes">
                                        {% for option in filters.attribute_options %}
                                            <option value="{{ option.id }}" {{ option.id in filters.selected_attribute_ids ? 'selected' : '' }}>{{ option.title }}</option>
                                        {% endfor %}
                                    </select>
                                </fieldset>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        {% if filters.active_chips %}
            <div class="bo-order-filters__active-chips d-flex flex-wrap align-items-center gap-2 mt-3" data-testid="product-active-chips">
                <span class="text-muted small">{{ 'Active filters:'|trans }}</span>
                {% for chip in filters.active_chips %}
                    <a class="bo-order-filters__chip d-inline-flex align-items-center gap-1 text-decoration-none"
                       href="{{ chip.remove_url }}"
                       data-testid="product-active-chip-{{ chip.key }}"
                       title="{{ 'Remove this filter'|trans }}">
                        <span class="bo-order-filters__chip-label">{{ chip.label }}:</span>
                        <strong class="bo-order-filters__chip-value">{{ chip.value }}</strong>
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </a>
                {% endfor %}
                <a class="bo-order-filters__clear-all small text-decoration-none ms-1"
                   href="{{ filters.clear_all_url }}"
                   data-testid="product-clear-all">
                    <i class="bi bi-eraser me-1" aria-hidden="true"></i>{{ 'Clear all'|trans }}
                </a>
            </div>
        {% endif %}

        {% if is_granted('UPDATE', 'admin.product') or is_granted('DELETE', 'admin.product') %}
            <div class="bo-bulk-toolbar card border-0 shadow-sm mb-3" data-bo-bulk-select-target="toolbar" hidden
                 data-testid="product-bulk-toolbar">
                <div class="card-body d-flex flex-wrap align-items-center gap-2 py-2">
                    <span class="badge text-bg-primary" data-testid="product-bulk-count">
                        <span data-bo-bulk-select-target="count">0</span>
                        {{ 'selected'|trans }}
                    </span>

                    <label class="visually-hidden" for="product-bulk-action">{{ 'Bulk actions'|trans }}</label>
                    <select id="product-bulk-action" class="form-select form-select-sm w-auto"
                            data-controller="bo-bulk-action-picker"
                            data-bo-bulk-action-picker-confirm-delete-value="{{ 'Delete the selected products? This cannot be undone.'|trans }}"
                            data-action="change->bo-bulk-action-picker#run"
                            data-testid="product-bulk-action-select">
                        <option value="">{{ 'Bulk actions'|trans }}</option>
                        {% if is_granted('UPDATE', 'admin.product') %}
                            <option value="edit">{{ 'Edit'|trans }}</option>
                            <option value="online">{{ 'Put online'|trans }}</option>
                            <option value="offline">{{ 'Take offline'|trans }}</option>
                        {% endif %}
                        {% if is_granted('DELETE', 'admin.product') %}
                            <option value="delete">{{ 'Delete'|trans }}</option>
                        {% endif %}
                    </select>

                    <button type="button" class="btn btn-sm btn-link" data-action="bo-bulk-select#clear"
                            data-testid="product-bulk-clear">{{ 'Clear selection'|trans }}</button>

                    {% if is_granted('UPDATE', 'admin.product') %}
                        <form method="post" action="{{ path('admin.products.bulk.edit') }}" class="d-none"
                              data-bo-bulk-select-target="form" data-bulk-form="online" data-testid="product-bulk-online-form">
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                            <input type="hidden" name="visibility" value="online">
                        </form>
                        <form method="post" action="{{ path('admin.products.bulk.edit') }}" class="d-none"
                              data-bo-bulk-select-target="form" data-bulk-form="offline" data-testid="product-bulk-offline-form">
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                            <input type="hidden" name="visibility" value="offline">
                        </form>
                    {% endif %}
                    {% if is_granted('DELETE', 'admin.product') %}
                        <form method="post" action="{{ path('admin.products.bulk.delete') }}" class="d-none"
                              data-bo-bulk-select-target="form" data-bulk-form="delete" data-testid="product-bulk-delete-form">
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {{ safe_hook('products.caption', { location: 'product_list_caption' }) }}

        {#- id/position aren't in the ticket's column table for this screen (absent from its
            9-column list); kept at the same 'lg' tier the ticket gives id/position on every other
            screen that has them, per dev decision. -#}
        {{ component('BoDataTable', {
            id: 'products',
            columns: [
                column_select('_select', 'Select this product'|trans, 'id', 'ref', visibleFrom: 'md'),
                column('id', 'ID'|trans, visibleFrom: 'md'),
                column_html('thumbnail_html', 'Image'|trans, 'center', visibleFrom: 'md'),
                column_html('ref_html', 'Reference'|trans, 'start', 'ref', visibleFrom: 'md'),
                column_html('title_html', 'Title'|trans, 'start', 'title'),
                column_html('price_html', 'Price'|trans, 'end', 'price'),
                column_html('promo_price_html', 'Sale price'|trans, 'end', visibleFrom: 'lg'),
                column_html('stock_html', 'Stock'|trans, 'center', 'quantity', visibleFrom: 'md'),
                column_toggle('visible', 'Online'|trans, 'toggle_visible_url'),
                column('position', 'Position'|trans, 'center', visibleFrom: 'lg'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No product matches the current filters.'|trans,
            extraColumnsHeaderHook: 'products.header',
            extraColumnsHook: 'products.row',
            headerHookContext: { location: 'product_list_header' },
            rowHookContext: { location: 'product_list_row' },
            rowHookArgs: { product_id: 'id' },
            sortField: filters.sort_field,
            sortDirection: filters.sort_direction,
            sortParam: 'product_order',
            sortKeepParams: query_params,
            tbodyAttributes: allow_manual_ordering ? {
                'data-controller': 'bo-sortable',
                'data-bo-sortable-url-value': update_position_url,
                'data-bo-sortable-token-value': update_position_token,
                'data-bo-sortable-param-name-value': 'product_id',
            } : {},
            rowIdentifierKey: 'ref',
        }) }}

        {{ component('BoPagination', {
            route: 'admin.products.default',
            currentPage: current_page,
            lastPage: pages,
            routeParams: query_params,
            ariaLabel: 'Product pagination',
            testid: 'product-pagination',
        }) }}

        {% if is_granted('UPDATE', 'admin.product') %}
            <div class="modal fade" id="product-bulk-edit-modal" tabindex="-1" aria-hidden="true" data-testid="product-bulk-edit-modal">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <form method="post" action="{{ path('admin.products.bulk.edit') }}" class="modal-content"
                          data-bo-bulk-select-target="form" data-testid="product-bulk-edit-form">
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                        <div class="modal-header">
                            <h2 class="modal-title h5">{{ 'Edit the selected products'|trans }}</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted small">
                                {{ 'Products concerned'|trans }} (<span data-bo-bulk-select-target="count">0</span>) :
                                <span class="fw-semibold" data-bo-bulk-select-target="summary"></span>
                            </p>
                            <p class="text-muted small">{{ 'Leave a field untouched to keep its current value.'|trans }}</p>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-visibility">{{ 'Online'|trans }}</label>
                                    <select id="bulk-visibility" name="visibility" class="form-select" data-testid="product-bulk-visibility">
                                        <option value="">{{ 'Unchanged'|trans }}</option>
                                        <option value="online">{{ 'Put online'|trans }}</option>
                                        <option value="offline">{{ 'Take offline'|trans }}</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-default-category">{{ 'Default category'|trans }}</label>
                                    <select id="bulk-default-category" name="default_category_id" class="form-select" data-testid="product-bulk-default-category">
                                        <option value="">{{ 'Unchanged'|trans }}</option>
                                        {% for cat in filters.category_options %}
                                            {% if cat.id > 0 %}<option value="{{ cat.id }}">{{ cat.title }}</option>{% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-template">{{ 'Product template'|trans }}</label>
                                    <select id="bulk-template" name="template_id" class="form-select" data-testid="product-bulk-template">
                                        <option value="">{{ 'Unchanged'|trans }}</option>
                                        <option value="0">{{ 'No template'|trans }}</option>
                                        {% for option in filters.template_options %}
                                            <option value="{{ option.id }}">{{ option.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-brand">{{ 'Brand / Supplier'|trans }}</label>
                                    <select id="bulk-brand" name="brand_id" class="form-select" data-testid="product-bulk-brand">
                                        <option value="">{{ 'Unchanged'|trans }}</option>
                                        <option value="0">{{ 'No brand'|trans }}</option>
                                        {% for option in filters.brand_options %}
                                            <option value="{{ option.id }}">{{ option.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            <hr>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-category-add">{{ 'Add additional categories'|trans }}</label>
                                    <select id="bulk-category-add" name="category_add_ids[]" class="form-select" multiple size="5" data-testid="product-bulk-category-add">
                                        {% for cat in filters.category_options %}
                                            {% if cat.id > 0 %}<option value="{{ cat.id }}">{{ cat.title }}</option>{% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-category-remove">{{ 'Remove additional categories'|trans }}</label>
                                    <select id="bulk-category-remove" name="category_remove_ids[]" class="form-select" multiple size="5" data-testid="product-bulk-category-remove">
                                        {% for cat in filters.category_options %}
                                            {% if cat.id > 0 %}<option value="{{ cat.id }}">{{ cat.title }}</option>{% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-content-add">{{ 'Add associated contents'|trans }}</label>
                                    <select id="bulk-content-add" name="content_add_ids[]" class="form-select" multiple size="5" data-testid="product-bulk-content-add">
                                        {% for option in bulk_contents %}
                                            <option value="{{ option.id }}">{{ option.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-content-remove">{{ 'Remove associated contents'|trans }}</label>
                                    <select id="bulk-content-remove" name="content_remove_ids[]" class="form-select" multiple size="5" data-testid="product-bulk-content-remove">
                                        {% for option in bulk_contents %}
                                            <option value="{{ option.id }}">{{ option.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="bulk-association-type">{{ 'Relation type'|trans }}</label>
                                    <select id="bulk-association-type" name="association_type" class="form-select" data-testid="product-bulk-association-type">
                                        {% for type in bulk_association_types %}
                                            <option value="{{ type.code }}">{{ type.title }}</option>
                                        {% endfor %}
                                    </select>
                                    <div class="form-text">{{ 'The two lists below add to, and remove from, this block of the product sheet.'|trans }}</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-association-add">{{ 'Add related products'|trans }}</label>
                                    <select id="bulk-association-add" name="association_add_ids[]" class="form-select" multiple size="5" data-testid="product-bulk-association-add">
                                        {% for option in bulk_products %}
                                            <option value="{{ option.id }}">{{ option.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="bulk-association-remove">{{ 'Remove related products'|trans }}</label>
                                    <select id="bulk-association-remove" name="association_remove_ids[]" class="form-select" multiple size="5" data-testid="product-bulk-association-remove">
                                        {% for option in bulk_products %}
                                            <option value="{{ option.id }}">{{ option.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                            <button type="submit" class="btn btn-primary" data-testid="product-bulk-edit-submit">
                                <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Apply to the selection'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}
    </div>

    {{ safe_hook('products.bottom') }}

    {% include '@BackOfficeDefaultTwig/catalog/product/_create_modal.html.twig' %}

    {{ component('BoConfirmDialog', {
        id: 'product-delete-modal',
        title: 'Delete product',
        formAction: path('admin.products.delete'),
        message: 'Do you really want to delete this product?',
        testid: 'product-delete',
        hook: 'product.delete-form',
        hookContext: { location: 'product_delete_form' },
        prefillTrigger: 'data-product-id',
        prefillInput: 'product_id',
    }) }}

    <div class="modal fade" id="product-clone-modal" tabindex="-1" aria-hidden="true"
         data-controller="bo-prefill-modal"
         data-bo-prefill-modal-source-trigger-value="data-product-id"
         data-bo-prefill-modal-target-input-value="thelia_product_clone[productId]">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                {% form_theme clone_form with bo_form_themes only %}
                {{ form_start(clone_form, { action: path('admin.products.clone'), method: 'post', attr: { 'data-testid': 'product-clone-form' } }) }}
                    <div class="modal-header">
                        <h2 class="modal-title h5">{{ 'Clone product'|trans }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            {{ form_label(clone_form.newRef) }}
                            {{ form_widget(clone_form.newRef, { attr: { class: 'form-control' } }) }}
                        </div>
                        {{ form_widget(clone_form.productId) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-primary" data-testid="product-clone-submit">{{ 'Clone'|trans }}</button>
                    </div>
                {{ form_end(clone_form) }}
            </div>
        </div>
    </div>
{% endblock %}
