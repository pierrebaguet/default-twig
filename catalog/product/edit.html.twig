{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit product'|trans }} - {{ product.title }}{% endblock %}
{% block body_testid %}catalog-product-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.products.default') }}">{{ 'Products'|trans }}</a></li>
            {% for crumb in breadcrumb_path|default([]) %}
                <li class="breadcrumb-item"><a href="{{ path('admin.categories.default', { category_id: crumb.id }) }}">{{ crumb.title }}</a></li>
            {% endfor %}
            <li class="breadcrumb-item active" aria-current="page">{{ product.title }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('product-edit.top', { product_id: product.id }) }}

    {% set extra_tabs = hook_block('product.tab', { product: product.id, id: product.id }) %}
    {# A module tab opens like a native one when current_tab names it; an unknown tab falls back to the general one. #}
    {% set current_tab = current_tab in ['general', 'attributes', 'pse', 'related', 'images', 'documents', 'seo', 'modules']|merge(extra_tabs|map(block => block.id)) ? current_tab : 'general' %}

    <div class="container-fluid" data-testid="product-edit-page"
         data-controller="bo-unsaved-changes"
         data-bo-unsaved-changes-modal-value="#product-unsaved-changes-modal">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ product.title }} <small class="text-muted">#{{ product.id }}</small></h1>
            <div class="d-flex flex-wrap gap-2">
                {% include '@BackOfficeDefaultTwig/_prev_next_buttons.html.twig' with {
                    prev_url: prev_url|default(null),
                    next_url: next_url|default(null),
                    prev_label: 'Edit previous product'|trans,
                    next_label: 'Edit next product'|trans,
                    testid: 'product',
                    guard_unsaved: true,
                } only %}
                {% if preview_url is defined and preview_url %}
                    <a href="{{ preview_url }}" target="_blank" rel="noopener" class="btn btn-outline-secondary flex-shrink-0" title="{{ 'Preview product page'|trans }}" data-testid="product-preview-btn">
                        <i class="bi bi-eye" aria-hidden="true"></i> {{ 'Preview'|trans }}
                    </a>
                {% endif %}
                {% if is_granted('CREATE', 'admin.product') %}
                    <button type="button" class="btn btn-outline-primary flex-shrink-0" data-bs-toggle="modal" data-bs-target="#product-clone-modal" data-testid="product-clone-btn">
                        <i class="bi bi-files" aria-hidden="true"></i> {{ 'Clone product'|trans }}
                    </button>
                {% endif %}
                <a href="{{ path('admin.products.default') }}" class="btn btn-outline-secondary flex-shrink-0">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to list'|trans }}
                </a>
            </div>
        </div>

        <div class="bo-tab-bar">
            <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'general' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" data-testid="product-tab-general">{{ 'General'|trans }}</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'attributes' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-attributes" type="button" data-testid="product-tab-attributes">{{ 'Attributes & Features'|trans }}</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'pse' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-pse" type="button" data-testid="product-tab-pse">{{ 'Combinations'|trans }}</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'related' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-related" type="button" data-testid="product-tab-related">{{ 'Related'|trans }}</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'images' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-images" type="button" data-testid="product-tab-images">{{ 'Images'|trans }}</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'documents' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button" data-testid="product-tab-documents">{{ 'Documents'|trans }}</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'seo' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-seo" type="button" data-testid="product-tab-seo">{{ 'SEO'|trans }}</button>
            </li>
            {% for block in extra_tabs %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link {% if current_tab == block.id %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#{{ block.id }}"
                            {% if block.href is defined and block.href %}data-href="{{ block.href }}"{% endif %}
                            type="button" data-testid="product-tab-{{ block.id }}">{{ block.title }}</button>
                </li>
            {% endfor %}
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'modules' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-modules" type="button" data-testid="product-tab-modules">{{ 'Modules'|trans }}</button>
            </li>
            </ul>
            <div class="bo-tab-bar__aside">
                {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
            </div>
        </div>

        <div class="tab-content">
            <div class="tab-pane fade {% if current_tab == 'general' %}show active{% endif %}" id="tab-general" role="tabpanel">
                {% if every_carrier_excluded %}
                    <div class="alert alert-warning" role="alert" data-testid="product-every-carrier-excluded">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        {{ 'No active carrier can ship this product any more: an order that contains it cannot be completed.'|trans }}
                    </div>
                {% endif %}
                {% form_theme form with bo_form_themes only %}
                {{ form_start(form, { action: path('admin.products.save', { product_id: product.id }), method: 'post', attr: { 'data-testid': 'product-edit-form', 'data-bo-unsaved-changes-target': 'form' } }) }}
                    <input type="hidden" name="product_id" value="{{ product.id }}">
                    {{ safe_hook('product.modification.form_top', { product_id: product.id }) }}
                    <div class="row">
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.ref) }}
                                    {{ form_widget(form.ref, { attr: { class: 'form-control' } }) }}
                                </div>
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.title) }}
                                    {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
                                </div>
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.chapo) }}
                                {{ form_widget(form.chapo, { attr: { class: 'form-control', rows: 3 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.description) }}
                                {{ form_widget(form.description, { attr: { class: 'form-control', rows: 8 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.postscriptum) }}
                                {{ form_widget(form.postscriptum, { attr: { class: 'form-control', rows: 3 } }) }}
                            </div>
                        </div>
                        <div class="col-md-4" data-controller="bo-virtual-toggle">
                            {{ safe_hook('product.modification.form-right.top', { product_id: product.id }) }}
                            <div class="form-check mb-3">
                                {{ form_widget(form.visible, { attr: { class: 'form-check-input' } }) }}
                                {{ form_label(form.visible, null, { label_attr: { class: 'form-check-label' } }) }}
                            </div>
                            <div class="form-check mb-3">
                                {{ form_widget(form.virtual, { attr: { class: 'form-check-input', 'data-bo-virtual-toggle-target': 'trigger', 'data-action': 'change->bo-virtual-toggle#update' } }) }}
                                {{ form_label(form.virtual, null, { label_attr: { class: 'form-check-label' } }) }}
                            </div>
                            <div class="form-check mb-3">
                                {{ form_widget(form.guest_checkout_forbidden, { attr: { class: 'form-check-input', 'data-testid': 'product-edit-guest-checkout-forbidden' } }) }}
                                {{ form_label(form.guest_checkout_forbidden, null, { label_attr: { class: 'form-check-label' } }) }}
                            </div>
                            {# Only on a core that carries the shipping rules of a product. #}
                            {% if form.free_shipping is defined %}
                            <div class="card mb-3" data-testid="product-edit-shipping" data-controller="bo-free-shipping">
                                <div class="card-body">
                                    <h2 class="h6 card-title">{{ 'Shipping'|trans }}</h2>
                                    <div class="form-check mb-3">
                                        {{ form_widget(form.free_shipping, { attr: { class: 'form-check-input', 'data-testid': 'product-edit-free-shipping', 'data-bo-free-shipping-target': 'trigger', 'data-action': 'change->bo-free-shipping#update' } }) }}
                                        {{ form_label(form.free_shipping, null, { label_attr: { class: 'form-check-label' } }) }}
                                    </div>
                                    <div data-bo-free-shipping-target="field">
                                        <div class="mb-3">
                                            {{ form_label(form.shipping_surcharge) }}
                                            <div class="input-group">
                                                {{ form_widget(form.shipping_surcharge, { attr: { class: 'form-control', min: 0, step: 'any', 'data-testid': 'product-edit-shipping-surcharge' } }) }}
                                                <span class="input-group-text">{{ default_currency_symbol|default('') }}</span>
                                            </div>
                                            <small class="form-text text-muted">{{ 'Added to the postage of the order, in the default currency. 0 for no surcharge.'|trans }}</small>
                                        </div>
                                        <div class="mb-0">
                                            {{ form_label(form.shipping_surcharge_mode) }}
                                            {{ form_widget(form.shipping_surcharge_mode, { attr: { class: 'form-select', 'data-testid': 'product-edit-shipping-surcharge-mode' } }) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                            <div class="mb-3">
                                {{ form_label(form.default_category) }}
                                <select name="{{ form.default_category.vars.full_name }}" class="form-select" data-testid="product-edit-category" required>
                                    {% for cat in available_categories %}
                                        <option value="{{ cat.id }}"{{ cat.id == form.default_category.vars.value ? ' selected' }}>{% if cat.depth > 0 %}{% for i in 1..cat.depth %}&nbsp;&nbsp;&nbsp;{% endfor %}{% endif %}{{ cat.title }}</option>
                                    {% endfor %}
                                </select>
                                {% do form.default_category.setRendered %}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.template_id) }}
                                <select name="{{ form.template_id.vars.full_name }}"
                                        class="form-select"
                                        data-testid="product-edit-template"
                                        data-controller="bo-template-notice"
                                        data-bo-template-notice-modal-value="#product-template-notice-modal"
                                        data-action="change->bo-template-notice#warn">
                                    {% for tpl in available_templates %}
                                        <option value="{{ tpl.id }}" {% if tpl.id == product.templateId %}selected{% endif %}>{{ tpl.name }}</option>
                                    {% endfor %}
                                </select>
                                {% do form.template_id.setRendered %}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.brand_id) }}
                                <select name="{{ form.brand_id.vars.full_name }}" class="form-select" data-testid="product-edit-brand">
                                    <option value="0">{{ '- No brand -'|trans }}</option>
                                    {% for brand in available_brands %}
                                        <option value="{{ brand.id }}"{{ brand.id == form.brand_id.vars.value ? ' selected' }}>{{ brand.title }}</option>
                                    {% endfor %}
                                </select>
                                {% do form.brand_id.setRendered %}
                            </div>
                            <div class="mb-3" data-bo-virtual-toggle-target="field">
                                {{ form_label(form.virtual_document_id) }}
                                {% if virtual_document_per_combination %}
                                    {# The document is set per combination: -1 tells the save action to leave every association untouched. #}
                                    <input type="hidden" name="{{ form.virtual_document_id.vars.full_name }}" value="-1">
                                    <small class="form-text text-muted d-block" data-testid="product-edit-virtual-document-per-combination">{{ 'This product has several combinations: attach a document to each of them in the Combinations tab.'|trans }}</small>
                                {% else %}
                                    <select name="{{ form.virtual_document_id.vars.full_name }}" class="form-select" data-testid="product-edit-virtual-document">
                                        <option value="0">{{ '- No document -'|trans }}</option>
                                        {% for doc in available_documents %}
                                            <option value="{{ doc.id }}"{{ doc.id == form.virtual_document_id.vars.value ? ' selected' }}>{{ doc.title }}</option>
                                        {% endfor %}
                                    </select>
                                    {% if available_documents is empty %}
                                        <small class="form-text text-muted">{{ 'Upload a document in the Documents tab and leave it non-visible to make it downloadable.'|trans }}</small>
                                    {% else %}
                                        <small class="form-text text-muted">{{ 'Only non-visible documents are listed.'|trans }}</small>
                                    {% endif %}
                                {% endif %}
                                {% do form.virtual_document_id.setRendered %}
                            </div>
                            {{ safe_hook('product.modification.form-right.bottom', { product_id: product.id }) }}
                            {% set edit_toolbar = {
                                closeUrl: path('admin.products.default'),
                                closeAttributes: { 'data-bo-unsaved-changes-target': 'link' },
                                closeFirst: false,
                                closeIcon: 'bi-x-lg',
                                saveIcon: 'bi-check-lg',
                                saveCloseIcon: 'bi-x-lg',
                                saveVariant: 'success',
                                saveCloseVariant: 'info',
                                iconAfterLabel: true,
                                align: 'start'
                            } %}
                            {% set edit_dates = 'Product created on %date_create. Last modification on %date_change'|trans({
                                '%date_create': product.createdAt ? product.createdAt|format_datetime('medium', 'short') : '-',
                                '%date_change': product.updatedAt ? product.updatedAt|format_datetime('medium', 'short') : '-',
                            }) %}
                            {{ component('BoSaveModeToolbar', edit_toolbar|merge({ wrapperClass: 'mb-2', testid: 'product-edit-top' })) }}
                            <p class="small text-muted mb-3" data-testid="product-edit-dates-top">{{ edit_dates }}</p>
                        </div>
                    </div>
                    {{ safe_hook('product.modification.form_bottom', { product_id: product.id }) }}
                    {{ form_widget(form.id) }}
                    {{ form_widget(form.locale) }}
                    {{ safe_hook('product.update-form', { product: product.id }) }}
                    {{ component('BoSaveModeToolbar', edit_toolbar|merge({ testid: 'product-edit' })) }}
                    <p class="small text-muted mt-3 mb-0" data-testid="product-edit-dates">{{ edit_dates }}</p>
                {{ form_widget(form._token) }}
                {# module fields added through the legacy form bridge are rendered by the module hooks, not auto-dumped #}
                {{ form_end(form, {render_rest: false}) }}

                {% if shipping_rules %}
                {# Outside the product form: these forms post on their own. #}
                <div class="card shadow-sm border-0 mt-3" data-testid="product-excluded-carriers">
                    <div class="card-body">
                        <h2 class="h5 mb-1">{{ 'Excluded carriers'|trans }}</h2>
                        <p class="text-muted">{{ 'The carriers this product cannot be shipped with. An order that contains it is not offered them.'|trans }}</p>

                        {% if available_carriers|length > 0 %}
                            <form method="post" action="{{ path('admin.products.carrier.exclude') }}" class="mb-3" data-testid="product-carrier-exclude-form">
                                <input type="hidden" name="product_id" value="{{ product.id }}">
                                <input type="hidden" name="_token" value="{{ shipping_token }}">
                                <label for="product-carrier-module-id" class="form-label">{{ 'Carrier'|trans }}</label>
                                <div class="input-group">
                                    <select id="product-carrier-module-id" name="module_id" class="form-select" required data-testid="product-carrier-select">
                                        <option value="">{{ 'Select a carrier...'|trans }}</option>
                                        {% for carrier in available_carriers %}
                                            <option value="{{ carrier.id }}">{{ carrier.title }}</option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-primary" data-testid="product-carrier-exclude-add">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Exclude'|trans }}
                                    </button>
                                </div>
                            </form>
                        {% endif %}

                        {% set carrier_rows = [] %}
                        {% for carrier in excluded_carriers %}
                            {% set carrier_rows = carrier_rows|merge([{
                                'id': carrier.id,
                                'title': carrier.title,
                                '_actions': [
                                    row_action('delete', 'Allow again'|trans, null, '#product-carrier-allow', 'UPDATE', 'admin.product', { 'module-id': carrier.id }),
                                ],
                            }]) %}
                        {% endfor %}

                        {{ component('BoDataTable', {
                            id: 'product-excluded-carrier',
                            columns: [
                                column('id', 'ID'|trans, hideBelow: 'md'),
                                column('title', 'Carrier'|trans),
                                column_actions(),
                            ],
                            rows: carrier_rows,
                            emptyMessage: 'No carrier is excluded for this product.'|trans,
                        }) }}
                    </div>
                </div>

                {% component 'BoConfirmDialog' with {
                    id: 'product-carrier-allow',
                    title: 'Allow a carrier again',
                    formAction: path('admin.products.carrier.allow'),
                    confirmLabel: 'Confirm',
                    testid: 'product-carrier-allow',
                    prefillTrigger: 'data-module-id',
                    prefillInput: 'module_id',
                } %}
                    {% block body %}
                        <p class="mb-0">{{ 'Do you really want to allow this carrier again for the product?'|trans }}</p>
                        <input type="hidden" name="product_id" value="{{ product.id }}">
                        <input type="hidden" name="module_id" value="" data-bo-prefill-modal-target="input">
                    {% endblock %}
                {% endcomponent %}
                {% endif %}

                {# Only on a core that carries the destination restrictions. #}
                {% if destination_restrictions %}
                <div class="card shadow-sm border-0 mt-3" data-testid="product-destination-restrictions">
                    <div class="card-body">
                        <h2 class="h5 mb-1">{{ 'Destination restrictions'|trans }}</h2>
                        <p class="text-muted">{{ 'The groups of destinations this product is kept from, or is served to only. An address outside what a group allows is refused this product at the cart, the address step and the order.'|trans }}</p>

                        {% if available_restrictions|length > 0 %}
                            <form method="post" action="{{ path('admin.products.destination-restriction.attach') }}" class="mb-3" data-testid="product-destination-restriction-attach-form">
                                <input type="hidden" name="product_id" value="{{ product.id }}">
                                <input type="hidden" name="_token" value="{{ destination_restriction_token }}">
                                <label for="product-destination-restriction-id" class="form-label">{{ 'Destination restriction'|trans }}</label>
                                <div class="input-group">
                                    <select id="product-destination-restriction-id" name="restriction_id" class="form-select" required data-testid="product-destination-restriction-select">
                                        <option value="">{{ 'Select a destination restriction...'|trans }}</option>
                                        {% for restriction in available_restrictions %}
                                            <option value="{{ restriction.id }}">{{ restriction.title }}</option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-primary" data-testid="product-destination-restriction-attach">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Attach'|trans }}
                                    </button>
                                </div>
                            </form>
                        {% endif %}

                        {% if product_restrictions is empty %}
                            <p class="text-muted mb-0" data-testid="product-destination-restrictions-empty">{{ 'No destination restriction applies to this product.'|trans }}</p>
                        {% else %}
                            <ul class="list-group" data-testid="product-destination-restriction-list">
                                {% for restriction in product_restrictions %}
                                    <li class="list-group-item d-flex flex-wrap gap-2 justify-content-between align-items-center" data-testid="product-destination-restriction-{{ restriction.id }}">
                                        <span>
                                            {% if is_granted('VIEW', 'admin.configuration.destination-restriction') %}
                                                <a href="{{ path('admin.destination-restriction.update', { restriction_id: restriction.id }) }}">{{ restriction.title }}</a>
                                            {% else %}
                                                {{ restriction.title }}
                                            {% endif %}
                                            <span class="text-muted small">{{ restriction.mode_allow ? 'Only listed destinations are served'|trans : 'Listed destinations are refused'|trans }}</span>
                                            {% if not restriction.active %}<span class="badge text-bg-secondary ms-1">{{ 'Inactive'|trans }}</span>{% endif %}
                                        </span>
                                        <form method="post" action="{{ path('admin.products.destination-restriction.detach') }}">
                                            <input type="hidden" name="product_id" value="{{ product.id }}">
                                            <input type="hidden" name="restriction_id" value="{{ restriction.id }}">
                                            <input type="hidden" name="_token" value="{{ destination_restriction_token }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" data-testid="product-destination-restriction-detach-{{ restriction.id }}">
                                                <i class="bi bi-x-lg" aria-hidden="true"></i> {{ 'Detach'|trans }}
                                            </button>
                                        </form>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
                {% endif %}

            </div>

            <div class="tab-pane fade {% if current_tab == 'attributes' %}show active{% endif %}" id="tab-attributes" role="tabpanel">
                {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\Catalog\\ProductAdvancedController::attributesTab', { product_id: product.id })) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'pse' %}show active{% endif %}" id="tab-pse" role="tabpanel">
                {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\Catalog\\ProductAdvancedController::combinationsTab', { product_id: product.id, currency_id: app.request.query.get('combinations_currency_id') })) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'related' %}show active{% endif %}" id="tab-related" role="tabpanel">
                {% include '@BackOfficeDefaultTwig/catalog/product/_related_tab.html.twig' %}
            </div>

            <div class="tab-pane fade {% if current_tab == 'images' %}show active{% endif %}" id="tab-images" role="tabpanel">
                {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\File\\FileController::imageForm', { parentType: 'product', parentId: product.id })) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'documents' %}show active{% endif %}" id="tab-documents" role="tabpanel">
                {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\File\\FileController::documentForm', { parentType: 'product', parentId: product.id })) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'seo' %}show active{% endif %}" id="tab-seo" role="tabpanel">
                {{ safe_hook('tab-seo.top', { id: product.id, type: 'product' }) }}
                {% form_theme seo_form with bo_form_themes only %}
                {{ form_start(seo_form, { action: path('admin.products.seo.save'), method: 'post', attr: { 'data-testid': 'product-seo-form' } }) }}
                    <div class="mb-3">
                        {{ form_label(seo_form.url) }}
                        {{ form_widget(seo_form.url, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(seo_form.meta_title) }}
                        {{ form_widget(seo_form.meta_title, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(seo_form.meta_description) }}
                        {{ form_widget(seo_form.meta_description, { attr: { class: 'form-control', rows: 3 } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(seo_form.meta_keywords) }}
                        {{ form_widget(seo_form.meta_keywords, { attr: { class: 'form-control', rows: 3 } }) }}
                    </div>
                    {{ form_widget(seo_form.id) }}
                    {{ form_widget(seo_form.locale) }}
                    <button type="submit" class="btn btn-primary" data-testid="product-seo-submit">
                        <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save SEO'|trans }}
                    </button>
                {{ form_widget(seo_form._token) }}
                {# module fields added through the legacy form bridge are rendered by the module hooks, not auto-dumped #}
                {{ form_end(seo_form, {render_rest: false}) }}
                {{ hook_cards(['product.seo.update-form', 'tab-seo.update-form', 'tab-seo.bottom'], { product: product.id, id: product.id, type: 'product' }) }}
            </div>

            {% for block in extra_tabs %}
                <div class="tab-pane fade {% if current_tab == block.id %}show active{% endif %}" id="{{ block.id }}" role="tabpanel">
                    {% if block.href is defined and block.href %}
                        <div class="text-center"><span class="loading">{{ 'Please wait, loading'|trans }}</span></div>
                    {% else %}
                        {{ block.content|raw }}
                    {% endif %}
                </div>
            {% endfor %}

            <div class="tab-pane fade {% if current_tab == 'modules' %}show active{% endif %}" id="tab-modules" role="tabpanel">
                {{ hook_cards('product.tab-content', { product: product.id, location: 'product-edit', view: 'product' }) }}
            </div>
        </div>

        <div class="modal fade" id="product-unsaved-changes-modal" tabindex="-1" aria-hidden="true" data-testid="product-unsaved-changes-modal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle text-warning" aria-hidden="true"></i>
                            {{ 'Unsaved changes'|trans }}
                        </h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">{{ 'This product has changes you have not saved yet. Leaving now discards them.'|trans }}</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-testid="product-unsaved-cancel">
                            {{ 'Keep editing'|trans }}
                        </button>
                        <button type="button" class="btn btn-outline-danger"
                                data-action="bo-unsaved-changes#leave"
                                data-testid="product-unsaved-leave">
                            {{ 'Leave without saving'|trans }}
                        </button>
                        <button type="button" class="btn btn-primary"
                                data-action="bo-unsaved-changes#save"
                                data-testid="product-unsaved-save">
                            <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% include '@BackOfficeDefaultTwig/catalog/product/_pse_assoc.html.twig' %}

    {{ component('BoWarningDialog', {
        id: 'product-template-notice-modal',
        title: 'Warning',
        message: 'If you change the product template, some of the product attribute combinations may be deleted, and you may have to reconfigure some of the product prices.',
        testid: 'product-template-notice',
    }) }}

    <div class="modal fade" id="product-clone-modal" tabindex="-1" aria-labelledby="product-clone-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                {% form_theme clone_form with bo_form_themes only %}
                {{ form_start(clone_form, { action: path('admin.products.clone'), method: 'post', attr: { 'data-testid': 'product-clone-form' } }) }}
                    <div class="modal-header">
                        <h5 class="modal-title" id="product-clone-modal-title">{{ 'Clone product'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="thelia_product_clone[productId]" value="{{ product.id }}">
                        {% do clone_form.productId.setRendered %}
                        <div class="mb-3">
                            {{ form_label(clone_form.newRef) }}
                            {{ form_widget(clone_form.newRef, { attr: { class: 'form-control', placeholder: product.ref ~ '-copy' } }) }}
                            {{ form_errors(clone_form.newRef) }}
                        </div>
                        {{ safe_hook('product.clone-form', { product: product.id }) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-primary" data-testid="product-clone-submit">
                            <i class="bi bi-files" aria-hidden="true"></i> {{ 'Clone product'|trans }}
                        </button>
                    </div>
                {{ form_end(clone_form) }}
            </div>
        </div>
    </div>

    {{ safe_hook('product-edit.bottom', { product_id: product.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('product.edit-js', { product_id: product.id, location: 'product-edit-js' }) }}
    {{ safe_hook('wysiwyg.js', { location: 'product-edit-js' }) }}
{% endblock %}
